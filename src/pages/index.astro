---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mole & Grams-to-Moles Calculator | FreeChemLab">
	<!-- Top Navigation Bar -->
	<header class="w-full bg-canvas border-b border-hairline-soft">
		<div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
			<!-- Logo / Wordmark -->
			<a href="/" class="text-base font-semibold text-ink tracking-tight flex items-center gap-1.5">
				<span class="text-brand-green font-bold text-lg leading-none">&bull;</span>
				<span>FreeChemLab</span>
			</a>

			<!-- Navigation Item (Active) -->
			<nav aria-label="Main Navigation">
				<ul class="flex items-center space-x-1">
					<li>
						<a 
							href="/calculators" 
							class="px-3 py-1.5 text-sm font-medium text-ink bg-surface rounded-full border border-hairline transition-colors" 
							aria-current="page"
						>
							Calculator
						</a>
					</li>
				</ul>
			</nav>
		</div>
	</header>

	<main class="w-full max-w-4xl mx-auto px-4 py-4 md:py-6">
		<!-- Breadcrumb Navigation -->
		<nav aria-label="Breadcrumb" class="mb-4">
			<ol class="flex items-center space-x-2 text-sm text-steel">
				<li>
					<a href="/" class="hover:text-ink transition-colors">Home</a>
				</li>
				<li>
					<span class="text-stone" aria-hidden="true">/</span>
				</li>
				<li>
					<a href="/calculators" class="hover:text-ink transition-colors">Calculators</a>
				</li>
				<li>
					<span class="text-stone" aria-hidden="true">/</span>
				</li>
				<li class="font-medium text-ink" aria-current="page">
					Mole &amp; Grams-to-Moles
				</li>
			</ol>
		</nav>

		<!-- Calculator Card Shell -->
		<section class="bg-canvas border border-hairline rounded-[12px] p-6 shadow-xs">
			<!-- Header Row -->
			<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-6 border-b border-hairline-soft">
				<div>
					<h1 class="text-xl md:text-2xl font-semibold text-ink tracking-tight">
						Mole &amp; Grams-to-Moles Calculator
					</h1>
				</div>

				<!-- Direction Toggle Chip -->
				<div class="inline-flex items-center p-1 bg-surface border border-hairline rounded-full text-xs font-medium self-start sm:self-auto">
					<button 
						id="toggle-g-to-mol"
						type="button" 
						class="px-3.5 py-1.5 bg-primary text-on-primary rounded-full transition-all cursor-pointer font-medium"
					>
						g &rarr; mol
					</button>
					<button 
						id="toggle-mol-to-g"
						type="button" 
						class="px-3.5 py-1.5 text-steel hover:text-ink rounded-full transition-all cursor-pointer font-medium"
					>
						mol &rarr; g
					</button>
				</div>
			</header>

			<!-- Calculator Inputs & Fields Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Field 1: Molar Mass -->
				<div class="bg-canvas border border-hairline rounded-[12px] p-5 flex flex-col justify-between">
					<div>
						<div class="flex items-center justify-between mb-2">
							<label for="molar-mass" class="block text-xs font-semibold uppercase tracking-wider text-steel">
								Molar Mass
							</label>
						</div>
						<input 
							type="number" 
							id="molar-mass" 
							step="any"
							placeholder="e.g. 18.02" 
							class="w-full bg-canvas text-ink font-mono text-base rounded-[8px] px-3.5 py-2.5 border border-hairline focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
						/>
						<!-- Inline Error Message -->
						<p id="molar-mass-error" class="hidden text-xs text-brand-error font-medium mt-1.5 font-sans">
							Molar mass must be greater than 0
						</p>
					</div>
					<!-- Molar Mass Unit Pills -->
					<div class="mt-4 pt-3 border-t border-hairline-soft">
						<div class="flex flex-wrap gap-2 items-center" id="molar-mass-units">
							<button 
								type="button" 
								data-unit="g/mol"
								class="unit-pill-mm min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-semibold bg-primary text-on-primary border border-primary cursor-pointer transition-all flex items-center justify-center"
							>
								g/mol
							</button>
							<button 
								type="button" 
								data-unit="kg/kmol"
								class="unit-pill-mm min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								kg/kmol
							</button>
						</div>
					</div>
				</div>

				<!-- Field 2: Mass Container -->
				<div id="mass-container" class="bg-canvas border border-hairline rounded-[12px] p-5 flex flex-col justify-between transition-colors">
					<div>
						<div class="flex items-center justify-between mb-2">
							<label for="mass-input" class="block text-xs font-semibold uppercase tracking-wider text-steel">
								Mass
							</label>
							<!-- Calculated Badge (Shown when readonly) -->
							<span id="mass-calculated-badge" class="hidden items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-steel bg-surface px-2 py-0.5 rounded border border-hairline">
								<svg class="w-3 h-3 text-steel shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
								</svg>
								Calculated
							</span>
						</div>
						<div class="relative flex items-center">
							<input 
								type="number" 
								id="mass-input" 
								step="any"
								placeholder="e.g. 18.02" 
								class="w-full bg-canvas text-ink font-mono text-base rounded-[8px] px-3.5 py-2.5 border border-hairline focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
							/>
							<div id="mass-lock-icon" class="hidden absolute right-3 pointer-events-none">
								<svg class="w-4 h-4 text-steel" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
								</svg>
							</div>
						</div>
						<!-- Inline Error Message -->
						<p id="mass-error" class="hidden text-xs text-brand-error font-medium mt-1.5 font-sans">
							Mass cannot be negative
						</p>
					</div>
					<!-- Mass Unit Pills -->
					<div class="mt-4 pt-3 border-t border-hairline-soft">
						<div class="flex flex-wrap gap-2 items-center" id="mass-units-primary">
							<button 
								type="button" 
								data-unit="mg"
								class="unit-pill-mass min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								mg
							</button>
							<button 
								type="button" 
								data-unit="g"
								class="unit-pill-mass min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-semibold bg-primary text-on-primary border border-primary cursor-pointer transition-all flex items-center justify-center"
							>
								g
							</button>
							<button 
								type="button" 
								data-unit="kg"
								class="unit-pill-mass min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								kg
							</button>
							<button 
								type="button" 
								id="toggle-mass-more"
								aria-label="More units"
								class="min-h-[44px] h-[44px] px-3 rounded-full text-xs font-bold bg-surface border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								&middot;&middot;&middot;
							</button>
						</div>
						<!-- Mass Secondary Units Row -->
						<div id="mass-units-secondary" class="hidden flex-wrap gap-2 items-center mt-2">
							<button 
								type="button" 
								data-unit="ng"
								class="unit-pill-mass min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								ng
							</button>
							<button 
								type="button" 
								data-unit="ug"
								class="unit-pill-mass min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								&micro;g
							</button>
							<button 
								type="button" 
								data-unit="dag"
								class="unit-pill-mass min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								dag
							</button>
						</div>
					</div>
				</div>

				<!-- Browse Elements Trigger + Panel (col-span-2, between inputs and result) -->
				<div class="md:col-span-2">
					<!-- Trigger -->
					<button
						id="browse-trigger"
						type="button"
						class="flex items-center gap-1.5 text-xs font-medium text-steel hover:text-ink transition-colors cursor-pointer"
					>
						<svg id="browse-chevron" class="w-3.5 h-3.5 text-stone transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
						</svg>
						Not sure of the molar mass? Browse elements
					</button>

					<!-- Collapsible Panel -->
					<div id="browse-panel" class="hidden mt-3 bg-canvas border border-hairline rounded-[12px] overflow-hidden">
						<!-- Tabs -->
						<div class="flex border-b border-hairline">
							<button
								id="tab-presets"
								type="button"
								class="px-5 py-3 text-xs font-semibold text-ink border-b-2 border-ink -mb-px transition-colors cursor-pointer"
							>
								Presets
							</button>
							<button
								id="tab-custom"
								type="button"
								class="px-5 py-3 text-xs font-medium text-steel border-b-2 border-transparent -mb-px hover:text-ink transition-colors cursor-pointer"
							>
								Build custom
							</button>
						</div>

						<!-- Presets Tab Content -->
						<div id="panel-presets" class="p-5">
							<label for="preset-select" class="block text-xs font-semibold uppercase tracking-wider text-steel mb-2">
								Common Compounds
							</label>
							<select
								id="preset-select"
								class="w-full bg-surface-soft border border-hairline text-ink text-sm font-sans rounded-[8px] px-3.5 py-2.5 focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
							>
								<option value="">Select a compound…</option>
								<option value="18.015">Water (H₂O) — 18.015 g/mol</option>
								<option value="58.44">Table Salt (NaCl) — 58.44 g/mol</option>
								<option value="44.01">Carbon Dioxide (CO₂) — 44.01 g/mol</option>
								<option value="180.16">Glucose (C₆H₁₂O₆) — 180.16 g/mol</option>
								<option value="46.07">Ethanol (C₂H₅OH) — 46.07 g/mol</option>
							</select>
							<button
								id="use-preset"
								type="button"
								class="hidden mt-3 px-4 py-2 bg-primary text-on-primary text-xs font-semibold rounded-full cursor-pointer transition-colors hover:bg-charcoal"
							>
								Use this molar mass
							</button>
						</div>

						<!-- Build Custom Tab Content -->
						<div id="panel-custom" class="hidden p-5">
							<!-- Search -->
							<input
								type="search"
								id="element-search"
								placeholder="Search by name or symbol…"
								class="w-full bg-surface-soft border border-hairline text-ink text-sm font-sans rounded-[8px] px-3.5 py-2.5 mb-4 focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
							/>

							<!-- Element Grid -->
							<div id="element-grid" class="grid grid-cols-4 sm:grid-cols-5 gap-2 mb-4">
								<!-- Rendered by JS -->
							</div>
							<p id="element-grid-empty" class="hidden text-xs text-stone text-center py-4">No elements match your search.</p>

							<!-- Formula Bar -->
							<div class="mt-4 pt-4 border-t border-hairline-soft flex flex-col sm:flex-row sm:items-center justify-between gap-3">
								<div>
									<span class="block text-[11px] font-semibold uppercase tracking-wider text-stone mb-0.5">Formula</span>
									<span id="custom-formula" class="text-base font-semibold font-mono text-ink">—</span>
								</div>
								<div class="text-right sm:text-right">
									<span class="block text-[11px] font-semibold uppercase tracking-wider text-stone mb-0.5">Molar Mass</span>
									<span id="custom-molar-mass-val" class="text-base font-semibold font-mono text-ink">—</span>
								</div>
								<button
									id="use-custom"
									type="button"
									class="hidden self-end sm:self-auto px-4 py-2 bg-primary text-on-primary text-xs font-semibold rounded-full cursor-pointer transition-colors hover:bg-charcoal whitespace-nowrap"
								>
									Use this molar mass
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Field 3: Moles Container -->
				<div id="moles-container" class="md:col-span-2 bg-surface-soft border border-hairline rounded-[12px] p-5 flex flex-col justify-between transition-colors">
					<div>
						<div class="flex items-center justify-between mb-2">
							<label for="moles-input" class="block text-xs font-semibold uppercase tracking-wider text-steel">
								Moles
							</label>
							<!-- Calculated Badge (Shown when readonly) -->
							<span id="moles-calculated-badge" class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-steel bg-canvas px-2 py-0.5 rounded border border-hairline">
								<svg class="w-3 h-3 text-steel shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
								</svg>
								Calculated
							</span>
						</div>
						<div class="relative flex items-center">
							<input 
								type="number" 
								id="moles-input" 
								step="any"
								readonly
								placeholder="0.000000" 
								class="w-full bg-surface border border-hairline text-ink font-mono text-base font-semibold rounded-[8px] px-3.5 py-2.5 cursor-not-allowed select-none focus:outline-none transition-all"
							/>
							<div id="moles-lock-icon" class="absolute right-3 pointer-events-none">
								<svg class="w-4 h-4 text-steel" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
								</svg>
							</div>
						</div>
						<!-- Inline Error Message -->
						<p id="moles-error" class="hidden text-xs text-brand-error font-medium mt-1.5 font-sans">
							Moles cannot be negative
						</p>

						<!-- Secondary Line: Particle Count (Only visible when Moles is the calculated result) -->
						<div id="particle-count-row" class="mt-3 pt-2.5 border-t border-hairline-soft flex flex-wrap items-center justify-between gap-1 text-xs">
							<span class="font-medium text-steel">Particle Count</span>
							<span id="particle-count-val" class="font-mono font-medium text-ink">
								&mdash;
							</span>
						</div>
					</div>
					<!-- Moles Unit Pills -->
					<div class="mt-4 pt-3 border-t border-hairline-soft">
						<div class="flex flex-wrap gap-2 items-center" id="moles-units-primary">
							<button 
								type="button" 
								data-unit="mol"
								class="unit-pill-moles min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-semibold bg-primary text-on-primary border border-primary cursor-pointer transition-all flex items-center justify-center"
							>
								mol
							</button>
							<button 
								type="button" 
								data-unit="mmol"
								class="unit-pill-moles min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								mmol
							</button>
							<button 
								type="button" 
								id="toggle-moles-more"
								aria-label="More units"
								class="min-h-[44px] h-[44px] px-3 rounded-full text-xs font-bold bg-surface border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								&middot;&middot;&middot;
							</button>
						</div>
						<!-- Moles Secondary Units Row -->
						<div id="moles-units-secondary" class="hidden flex-wrap gap-2 items-center mt-2">
							<button 
								type="button" 
								data-unit="umol"
								class="unit-pill-moles min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								&micro;mol
							</button>
							<button 
								type="button" 
								data-unit="nmol"
								class="unit-pill-moles min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								nmol
							</button>
							<button 
								type="button" 
								data-unit="pmol"
								class="unit-pill-moles min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center"
							>
								pmol
							</button>
						</div>
					</div>
				</div>
			</div>

		</section>
	</main>

	<!-- Footer -->
	<footer class="w-full border-t border-hairline-soft py-4 mt-auto">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<p class="text-xs text-steel font-normal">
				&copy; 2026 FreeChemLab
			</p>
		</div>
	</footer>
</Layout>

<script>
	import { 
		calculateMolesWithUnits, 
		calculateMassWithUnits, 
		toBaseMoles,
		calculateParticles,
		formatParticleCount,
		format6Decimals,
		type MolarMassUnit,
		type MassUnit,
		type MolesUnit
	} from '../utils/units';

	let currentMode: 'g_to_mol' | 'mol_to_g' = 'g_to_mol';

	let molarMassUnit: MolarMassUnit = 'g/mol';
	let massUnit: MassUnit = 'g';
	let molesUnit: MolesUnit = 'mol';

	const toggleGtoMolBtn = document.getElementById('toggle-g-to-mol');
	const toggleMolToGBtn = document.getElementById('toggle-mol-to-g');

	const molarMassInput = document.getElementById('molar-mass') as HTMLInputElement | null;
	const molarMassError = document.getElementById('molar-mass-error');
	
	const massContainer = document.getElementById('mass-container');
	const massInput = document.getElementById('mass-input') as HTMLInputElement | null;
	const massError = document.getElementById('mass-error');
	const massCalculatedBadge = document.getElementById('mass-calculated-badge');
	const massLockIcon = document.getElementById('mass-lock-icon');

	const molesContainer = document.getElementById('moles-container');
	const molesInput = document.getElementById('moles-input') as HTMLInputElement | null;
	const molesError = document.getElementById('moles-error');
	const molesCalculatedBadge = document.getElementById('moles-calculated-badge');
	const molesLockIcon = document.getElementById('moles-lock-icon');

	const particleCountRow = document.getElementById('particle-count-row');
	const particleCountVal = document.getElementById('particle-count-val');

	const toggleMassMoreBtn = document.getElementById('toggle-mass-more');
	const massSecondaryRow = document.getElementById('mass-units-secondary');

	const toggleMolesMoreBtn = document.getElementById('toggle-moles-more');
	const molesSecondaryRow = document.getElementById('moles-units-secondary');

	function updateModeUI() {
		clearAllErrors();
		if (currentMode === 'g_to_mol') {
			// g -> mol: Moles field is READONLY calculated output, Mass field is EDITABLE input
			toggleGtoMolBtn?.classList.add('bg-primary', 'text-on-primary');
			toggleGtoMolBtn?.classList.remove('text-steel');
			toggleMolToGBtn?.classList.remove('bg-primary', 'text-on-primary');
			toggleMolToGBtn?.classList.add('text-steel');

			// Editable Mass Field Styling
			if (massInput) {
				massInput.readOnly = false;
				massInput.className = "w-full bg-canvas text-ink font-mono text-base rounded-[8px] px-3.5 py-2.5 border border-hairline focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all";
			}
			massContainer?.classList.remove('bg-surface-soft');
			massContainer?.classList.add('bg-canvas');
			massCalculatedBadge?.classList.add('hidden');
			massCalculatedBadge?.classList.remove('flex');
			massLockIcon?.classList.add('hidden');

			// Readonly Moles Field Styling
			if (molesInput) {
				molesInput.readOnly = true;
				molesInput.className = "w-full bg-surface border border-hairline text-ink font-mono text-base font-semibold rounded-[8px] px-3.5 py-2.5 cursor-not-allowed select-none focus:outline-none transition-all";
			}
			molesContainer?.classList.remove('bg-canvas');
			molesContainer?.classList.add('bg-surface-soft');
			molesCalculatedBadge?.classList.remove('hidden');
			molesCalculatedBadge?.classList.add('flex');
			molesLockIcon?.classList.remove('hidden');

			particleCountRow?.classList.remove('hidden');
			particleCountRow?.classList.add('flex');
		} else {
			// mol -> g: Mass field is READONLY calculated output, Moles field is EDITABLE input
			toggleMolToGBtn?.classList.add('bg-primary', 'text-on-primary');
			toggleMolToGBtn?.classList.remove('text-steel');
			toggleGtoMolBtn?.classList.remove('bg-primary', 'text-on-primary');
			toggleGtoMolBtn?.classList.add('text-steel');

			// Editable Moles Field Styling
			if (molesInput) {
				molesInput.readOnly = false;
				molesInput.className = "w-full bg-canvas text-ink font-mono text-base rounded-[8px] px-3.5 py-2.5 border border-hairline focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all";
			}
			molesContainer?.classList.remove('bg-surface-soft');
			molesContainer?.classList.add('bg-canvas');
			molesCalculatedBadge?.classList.add('hidden');
			molesCalculatedBadge?.classList.remove('flex');
			molesLockIcon?.classList.add('hidden');

			// Readonly Mass Field Styling
			if (massInput) {
				massInput.readOnly = true;
				massInput.className = "w-full bg-surface border border-hairline text-ink font-mono text-base font-semibold rounded-[8px] px-3.5 py-2.5 cursor-not-allowed select-none focus:outline-none transition-all";
			}
			massContainer?.classList.remove('bg-canvas');
			massContainer?.classList.add('bg-surface-soft');
			massCalculatedBadge?.classList.remove('hidden');
			massCalculatedBadge?.classList.add('flex');
			massLockIcon?.classList.remove('hidden');

			particleCountRow?.classList.add('hidden');
			particleCountRow?.classList.remove('flex');
		}
		recalculate();
	}

	function clearAllErrors() {
		molarMassError?.classList.add('hidden');
		molarMassInput?.classList.remove('border-brand-error');
		molarMassInput?.classList.add('border-hairline');

		massError?.classList.add('hidden');
		massInput?.classList.remove('border-brand-error');
		massInput?.classList.add('border-hairline');

		molesError?.classList.add('hidden');
		molesInput?.classList.remove('border-brand-error');
		molesInput?.classList.add('border-hairline');
	}

	function recalculate() {
		clearAllErrors();

		const rawMolarMass = molarMassInput?.value ?? '';
		const molarMassVal = parseFloat(rawMolarMass);
		let hasError = false;

		// Molar mass validation: must be greater than 0
		if (rawMolarMass.trim() !== '' && (isNaN(molarMassVal) || molarMassVal <= 0)) {
			if (molarMassError) {
				molarMassError.textContent = 'Molar mass must be greater than 0';
				molarMassError.classList.remove('hidden');
			}
			molarMassInput?.classList.add('border-brand-error');
			molarMassInput?.classList.remove('border-hairline');
			hasError = true;
		}

		if (currentMode === 'g_to_mol') {
			const rawMass = massInput?.value ?? '';
			const massVal = parseFloat(rawMass);

			// Mass validation: must be non-negative
			if (rawMass.trim() !== '' && (isNaN(massVal) || massVal < 0)) {
				if (massError) {
					massError.textContent = 'Mass cannot be negative';
					massError.classList.remove('hidden');
				}
				massInput?.classList.add('border-brand-error');
				massInput?.classList.remove('border-hairline');
				hasError = true;
			}

			if (hasError || rawMolarMass.trim() === '' || rawMass.trim() === '' || isNaN(molarMassVal) || molarMassVal <= 0 || isNaN(massVal) || massVal < 0) {
				if (molesInput) molesInput.value = '—';
				if (particleCountVal) particleCountVal.textContent = '—';
				return;
			}

			const molesResult = calculateMolesWithUnits(
				massVal, 
				massUnit, 
				molarMassVal, 
				molarMassUnit, 
				molesUnit
			);
			if (molesInput) molesInput.value = format6Decimals(molesResult);

			// Calculate particle count
			const molesInMol = toBaseMoles(molesResult, molesUnit);
			const particles = calculateParticles(molesInMol);
			if (particleCountVal) particleCountVal.textContent = formatParticleCount(particles);
		} else {
			const rawMoles = molesInput?.value ?? '';
			const molesVal = parseFloat(rawMoles);

			// Moles validation: must be non-negative
			if (rawMoles.trim() !== '' && (isNaN(molesVal) || molesVal < 0)) {
				if (molesError) {
					molesError.textContent = 'Moles cannot be negative';
					molesError.classList.remove('hidden');
				}
				molesInput?.classList.add('border-brand-error');
				molesInput?.classList.remove('border-hairline');
				hasError = true;
			}

			if (hasError || rawMolarMass.trim() === '' || rawMoles.trim() === '' || isNaN(molarMassVal) || molarMassVal <= 0 || isNaN(molesVal) || molesVal < 0) {
				if (massInput) massInput.value = '—';
				if (particleCountVal) particleCountVal.textContent = '—';
				return;
			}

			const massResult = calculateMassWithUnits(
				molesVal, 
				molesUnit, 
				molarMassVal, 
				molarMassUnit, 
				massUnit
			);
			if (massInput) massInput.value = format6Decimals(massResult);
		}
	}

	function updatePillStyles(buttons: NodeListOf<HTMLButtonElement>, selectedUnit: string) {
		buttons.forEach(btn => {
			const unit = btn.getAttribute('data-unit');
			if (unit === selectedUnit) {
				btn.className = "min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-semibold bg-primary text-on-primary border border-primary cursor-pointer transition-all flex items-center justify-center shadow-xs";
			} else {
				btn.className = "min-h-[44px] h-[44px] px-3.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-steel hover:text-ink hover:border-steel cursor-pointer transition-all flex items-center justify-center";
			}
		});
	}

	// Molar mass unit selection
	const mmButtons = document.querySelectorAll<HTMLButtonElement>('.unit-pill-mm');
	mmButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const unit = btn.getAttribute('data-unit') as MolarMassUnit;
			if (unit) {
				molarMassUnit = unit;
				updatePillStyles(mmButtons, molarMassUnit);
				recalculate();
			}
		});
	});

	// Mass unit selection
	const massButtons = document.querySelectorAll<HTMLButtonElement>('.unit-pill-mass');
	massButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const unit = btn.getAttribute('data-unit') as MassUnit;
			if (unit) {
				massUnit = unit;
				updatePillStyles(massButtons, massUnit);
				recalculate();
			}
		});
	});

	// Moles unit selection
	const molesButtons = document.querySelectorAll<HTMLButtonElement>('.unit-pill-moles');
	molesButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const unit = btn.getAttribute('data-unit') as MolesUnit;
			if (unit) {
				molesUnit = unit;
				updatePillStyles(molesButtons, molesUnit);
				recalculate();
			}
		});
	});

	// Secondary rows toggle
	toggleMassMoreBtn?.addEventListener('click', () => {
		massSecondaryRow?.classList.toggle('hidden');
		massSecondaryRow?.classList.toggle('flex');
	});

	toggleMolesMoreBtn?.addEventListener('click', () => {
		molesSecondaryRow?.classList.toggle('hidden');
		molesSecondaryRow?.classList.toggle('flex');
	});

	// Mode toggle listeners
	toggleGtoMolBtn?.addEventListener('click', () => {
		if (currentMode !== 'g_to_mol') {
			currentMode = 'g_to_mol';
			updateModeUI();
		}
	});

	toggleMolToGBtn?.addEventListener('click', () => {
		if (currentMode !== 'mol_to_g') {
			currentMode = 'mol_to_g';
			updateModeUI();
		}
	});

	// Input listeners
	molarMassInput?.addEventListener('input', recalculate);
	massInput?.addEventListener('input', recalculate);
	molesInput?.addEventListener('input', recalculate);

	// Initial render setup
	updateModeUI();
</script>

<script>
	import { SEED_ELEMENTS, buildFormula, computeCustomMolarMass } from '../utils/browseElements';

	// --- DOM refs ---
	const molarMassInput = document.getElementById('molar-mass') as HTMLInputElement | null;
	const browseTrigger = document.getElementById('browse-trigger');
	const browseChevron = document.getElementById('browse-chevron');
	const browsePanel = document.getElementById('browse-panel');

	const tabPresets = document.getElementById('tab-presets');
	const tabCustom = document.getElementById('tab-custom');
	const panelPresets = document.getElementById('panel-presets');
	const panelCustom = document.getElementById('panel-custom');

	const presetSelect = document.getElementById('preset-select') as HTMLSelectElement | null;
	const usePresetBtn = document.getElementById('use-preset');

	const elementSearch = document.getElementById('element-search') as HTMLInputElement | null;
	const elementGrid = document.getElementById('element-grid');
	const elementGridEmpty = document.getElementById('element-grid-empty');
	const customFormula = document.getElementById('custom-formula');
	const customMolarMassVal = document.getElementById('custom-molar-mass-val');
	const useCustomBtn = document.getElementById('use-custom');

	// --- State ---
	const quantities = new Map<string, number>();
	let panelOpen = false;
	let activeTab: 'presets' | 'custom' = 'presets';

	// --- Panel toggle ---
	browseTrigger?.addEventListener('click', () => {
		panelOpen = !panelOpen;
		browsePanel?.classList.toggle('hidden', !panelOpen);
		browseChevron?.classList.toggle('rotate-90', panelOpen);
		if (panelOpen && activeTab === 'custom') renderGrid();
	});

	function collapsePanel() {
		panelOpen = false;
		browsePanel?.classList.add('hidden');
		browseChevron?.classList.remove('rotate-90');
	}

	// --- Tab switching ---
	function setTab(tab: 'presets' | 'custom') {
		activeTab = tab;
		const presetActive = tab === 'presets';
		panelPresets?.classList.toggle('hidden', !presetActive);
		panelCustom?.classList.toggle('hidden', presetActive);

		const activeClass = 'px-5 py-3 text-xs font-semibold text-ink border-b-2 border-ink -mb-px transition-colors cursor-pointer';
		const inactiveClass = 'px-5 py-3 text-xs font-medium text-steel border-b-2 border-transparent -mb-px hover:text-ink transition-colors cursor-pointer';
		if (tabPresets) tabPresets.className = presetActive ? activeClass : inactiveClass;
		if (tabCustom) tabCustom.className = presetActive ? inactiveClass : activeClass;

		if (tab === 'custom') renderGrid();
	}

	tabPresets?.addEventListener('click', () => setTab('presets'));
	tabCustom?.addEventListener('click', () => setTab('custom'));

	// --- Presets ---
	presetSelect?.addEventListener('change', () => {
		if (usePresetBtn) {
			usePresetBtn.classList.toggle('hidden', !presetSelect.value);
		}
	});

	usePresetBtn?.addEventListener('click', () => {
		const val = presetSelect?.value;
		if (!val || !molarMassInput) return;
		molarMassInput.value = val;
		molarMassInput.dispatchEvent(new Event('input'));
		collapsePanel();
		if (presetSelect) presetSelect.value = '';
		usePresetBtn.classList.add('hidden');
	});

	// --- Element Grid ---
	function renderGrid(filter = '') {
		if (!elementGrid) return;
		elementGrid.innerHTML = '';
		const lc = filter.toLowerCase().trim();
		const visible = lc
			? SEED_ELEMENTS.filter(el => el.name.toLowerCase().includes(lc) || el.symbol.toLowerCase().includes(lc))
			: SEED_ELEMENTS;

		const isEmpty = visible.length === 0;
		elementGrid.classList.toggle('hidden', isEmpty);
		elementGridEmpty?.classList.toggle('hidden', !isEmpty);

		visible.forEach(el => {
			const qty = quantities.get(el.symbol) ?? 0;
			const card = document.createElement('div');
			card.className = [
				'flex flex-col items-center justify-between rounded-[10px] border transition-all overflow-hidden',
				qty > 0 ? 'border-brand-green bg-canvas' : 'border-hairline bg-surface-soft'
			].join(' ');

			const infoArea = document.createElement('button');
			infoArea.type = 'button';
			infoArea.className = 'w-full flex flex-col items-center pt-3 pb-2 cursor-pointer select-none focus:outline-none';
			infoArea.innerHTML = `
				<span class="text-lg font-bold font-mono text-ink leading-tight">${el.symbol}</span>
				<span class="text-[10px] font-medium text-stone leading-none mt-0.5 truncate w-full text-center px-1">${el.name}</span>
				<span class="text-[10px] font-mono text-muted mt-0.5">${el.atomicWeight}</span>
			`;
			infoArea.addEventListener('click', () => {
				if (!quantities.has(el.symbol) || quantities.get(el.symbol) === 0) {
					quantities.set(el.symbol, 1);
					renderGrid(filter);
					updateFormulaBar();
				}
			});

			card.appendChild(infoArea);

			// Stepper (visible only when qty > 0)
			if (qty > 0) {
				const stepper = document.createElement('div');
				stepper.className = 'w-full flex items-center justify-between border-t border-hairline';

				const minusBtn = document.createElement('button');
				minusBtn.type = 'button';
				minusBtn.className = 'flex-1 flex items-center justify-center min-h-[44px] text-base font-semibold text-steel hover:text-ink hover:bg-surface-soft transition-colors cursor-pointer focus:outline-none';
				minusBtn.textContent = '−';
				minusBtn.addEventListener('click', () => {
					const current = quantities.get(el.symbol) ?? 0;
					if (current <= 1) {
						quantities.delete(el.symbol);
					} else {
						quantities.set(el.symbol, current - 1);
					}
					renderGrid(filter);
					updateFormulaBar();
				});

				const qtyDisplay = document.createElement('span');
				qtyDisplay.className = 'px-1 text-sm font-semibold font-mono text-ink select-none min-w-[20px] text-center';
				qtyDisplay.textContent = String(qty);

				const plusBtn = document.createElement('button');
				plusBtn.type = 'button';
				plusBtn.className = 'flex-1 flex items-center justify-center min-h-[44px] text-base font-semibold text-steel hover:text-ink hover:bg-surface-soft transition-colors cursor-pointer focus:outline-none';
				plusBtn.textContent = '+';
				plusBtn.addEventListener('click', () => {
					quantities.set(el.symbol, (quantities.get(el.symbol) ?? 0) + 1);
					renderGrid(filter);
					updateFormulaBar();
				});

				stepper.appendChild(minusBtn);
				stepper.appendChild(qtyDisplay);
				stepper.appendChild(plusBtn);
				card.appendChild(stepper);
			}

			elementGrid.appendChild(card);
		});
	}

	// --- Formula bar ---
	function updateFormulaBar() {
		const hasSelection = quantities.size > 0;
		const formula = hasSelection ? buildFormula(quantities) : '—';
		const mass = hasSelection ? computeCustomMolarMass(quantities) : 0;

		if (customFormula) customFormula.textContent = formula || '—';
		if (customMolarMassVal) {
			customMolarMassVal.textContent = hasSelection ? `${mass.toFixed(3)} g/mol` : '—';
		}
		useCustomBtn?.classList.toggle('hidden', !hasSelection);
	}

	useCustomBtn?.addEventListener('click', () => {
		if (!molarMassInput) return;
		const mass = computeCustomMolarMass(quantities);
		molarMassInput.value = String(mass.toFixed(3));
		molarMassInput.dispatchEvent(new Event('input'));
		collapsePanel();
		quantities.clear();
		if (elementSearch) elementSearch.value = '';
		updateFormulaBar();
	});

	// --- Search ---
	elementSearch?.addEventListener('input', () => {
		renderGrid(elementSearch.value);
	});

	// Initial render
	renderGrid();
</script>






