									class="unit-pill-moles min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
