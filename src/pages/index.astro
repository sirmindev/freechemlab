				<div id="result-slot" class="md:col-span-2 bg-surface-soft inset-ring-1 inset-ring-hairline rounded-[12px] p-[16px] mobile:p-6">
					<div id="moles-field-content" class="h-full flex flex-col justify-start transition-opacity duration-150">
						<div>
							<div class="flex items-center justify-between mb-2">
