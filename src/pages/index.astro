---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mole & Grams-to-Moles Calculator | FreeChemLab">
	<!-- Top Navigation Bar -->
	<header class="w-full bg-canvas border-b border-hairline-soft">
		<div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
			<!-- Logo / Wordmark -->
			<a href="/" class="text-base font-semibold text-ink tracking-tight flex items-center gap-1.5">
				<span class="text-brand-green font-bold text-lg leading-none">&bull;</span>
				<span>FreeChemLab</span>
			</a>

			<!-- Navigation Item (Active) -->
			<nav aria-label="Main Navigation">
				<ul class="flex items-center space-x-1">
					<li>
						<a
							href="/calculators"
							class="px-3 py-1.5 text-sm font-medium text-ink bg-surface rounded-full border border-hairline transition-colors"
							aria-current="page"
						>
							Calculator
						</a>
					</li>
				</ul>
			</nav>
		</div>
	</header>

	<main class="w-full max-w-4xl mx-auto px-4 py-4 md:py-6">
		<!-- Breadcrumb Navigation -->
		<nav aria-label="Breadcrumb" class="mb-4">
			<ol class="flex items-center space-x-2 text-sm text-steel">
				<li>
					<a href="/" class="hover:text-ink transition-colors">Home</a>
				</li>
				<li>
					<span class="text-stone" aria-hidden="true">/</span>
				</li>
				<li>
					<a href="/calculators" class="hover:text-ink transition-colors">Calculators</a>
				</li>
				<li>
					<span class="text-stone" aria-hidden="true">/</span>
				</li>
				<li class="font-medium text-ink" aria-current="page">
					Mole &amp; Grams-to-Moles
				</li>
			</ol>
		</nav>

		<!-- Calculator Card Shell -->
		<section class="bg-surface border border-hairline rounded-[16px] p-6">
			<!-- Header Row -->
			<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-6 border-b border-hairline-soft">
				<div>
					<h1 class="text-xl md:text-2xl font-semibold text-ink tracking-tight">
						Mole &amp; Grams-to-Moles Calculator
					</h1>
				</div>

				<!-- Direction Toggle: toggle-direction, two-word segments joined by a chevron -->
				<div class="inline-flex items-center gap-1 p-1 bg-transparent border border-hairline rounded-full self-start sm:self-auto">
					<button
						id="toggle-g-to-mol"
						type="button"
						class="min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 text-sm font-medium bg-brand-green text-on-primary hover:bg-brand-green-deep rounded-full transition-all cursor-pointer flex items-center gap-1"
					>
						<span>g</span>
						<svg class="shrink-0" width="5.5" height="9.5" viewBox="0 0 5.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M0.75 8.75L4.75 4.75L0.75 0.75" />
						</svg>
						<span>mol</span>
					</button>
					<button
						id="toggle-mol-to-g"
						type="button"
						class="min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 text-sm font-medium text-ink-muted hover:bg-surface-soft hover:text-ink rounded-full transition-all cursor-pointer flex items-center gap-1"
					>
						<span>mol</span>
						<svg class="shrink-0" width="5.5" height="9.5" viewBox="0 0 5.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M0.75 8.75L4.75 4.75L0.75 0.75" />
						</svg>
						<span>g</span>
					</button>
				</div>
			</header>

			<!-- Calculator Inputs & Fields Grid -->
			<div class="flex flex-col gap-6">
				<!-- Molar Mass + Mass: card-field, merged into one card (no gap, no divider) —
				     split by asymmetric padding: 24px outer edges, 12px on the shared midline -->
				<div class="field-row w-full bg-surface-soft border border-hairline rounded-[12px] flex flex-col">
					<!-- Molar Mass: input-slot-a. Permanent — always the first input, never moves,
					     never re-parented. Must stay the literal first child of .field-row (the
					     520px+ padding-right rule targets :first-child). -->
					<div id="input-slot-a" class="field-half flex flex-col justify-between p-6">
						<div>
							<div class="flex items-center justify-between mb-2">
								<label for="molar-mass" class="block text-xs font-semibold uppercase tracking-[0.4px] text-ink-muted">
									Molar Mass
								</label>
							</div>
							<div class="relative flex items-center">
								<input
									type="number"
									id="molar-mass"
									step="1"
									placeholder="e.g. 18.02"
									class="w-full bg-surface text-ink font-mono text-base rounded-[8px] pl-3 pr-[80px] mobile:pr-[72px] py-[11px] mobile:py-[9px] focus:py-[10px] mobile:focus:py-[8px] border border-hairline focus:outline-none focus:border-2 focus:border-brand-green focus:ring-0 transition-all"
								/>
								<!-- Functional stepper — one capsule, not two circles. Rounding is per-side,
								     not per-button: "-" is permanently rounded-l-full/square-right (it never
								     appears without "+" beside it), "+" is rounded-full (full circle) while
								     alone and switches to rounded-r-full/square-left the moment "-" mounts —
								     toggled in updateStepperState alongside its other state classes. The two
								     chips sit flush (the row has no `gap-*`), so the only seam is the 1px
								     white divider; nothing else may add a gap or the capsule silhouette
								     breaks apart into two circles again. Fill lives per-button on each
								     painted chip (bg-surface-4 default) — 24×24 at `mobile:` (≥520px) and up,
								     32×32 below it — not on a shared pill background. No border in any state.
								     Hover/pressed are wrapped in an explicit `(hover: hover)` media condition
								     (Tailwind's own `hover:`/`group-hover:` already carry that scoping by
								     default — see DESIGN.md — but `active`/`group-active` do not, so pressed
								     is scoped explicitly) so touch taps never show a stuck hover/press fill.
								     Right-anchored (not left): the row's width is intrinsic to its visible
								     children, so hiding/showing "-" and the divider changes the LEFT edge
								     only — "+" stays pinned to the same x position at every value, by
								     construction. Each button paints small but hit-tests the input's full
								     height — 48px below 520px, 44px at/above it: `py-2` (mobile) /
								     `mobile:py-2.5` (desktop) on the transparent outer `<button>` makes up
								     the difference against the 32px/24px chip. Both the chip and the input
								     grew by 4px on mobile in the same change, so this padding pair is
								     unchanged from the 28px-chip/44px-input generation — same "hit area
								     independent of painted size" pattern as the element-grid stepper
								     (`element-tile-stepper-button`). -->
								<div id="molar-mass-stepper" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center">
									<button type="button" id="molar-mass-step-down" aria-label="Decrease molar mass" class="hidden group flex items-center justify-center py-2 mobile:py-2.5 cursor-not-allowed focus:outline-none">
										<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-l-full bg-surface-4 text-ink-tertiary transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
											<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</span>
									</button>
									<div id="molar-mass-stepper-divider" class="hidden w-px h-8 mobile:h-6 bg-white"></div>
									<button type="button" id="molar-mass-step-up" aria-label="Increase molar mass" class="group flex items-center justify-center py-2 mobile:py-2.5 cursor-pointer focus:outline-none">
										<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-full bg-surface-4 text-ink-muted transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
											<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</span>
									</button>
								</div>
							</div>
							<!-- Inline Error Message -->
							<div id="molar-mass-error" class="hidden flex items-center gap-2 mt-1 text-sm text-brand-error">
								<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
								<span>Molar mass must be greater than 0</span>
							</div>
						</div>
						<!-- Molar Mass Unit Pills -->
						<div class="mt-4">
							<div class="flex flex-wrap gap-2 items-center" id="molar-mass-units">
								<button
									type="button"
									data-unit="g/mol"
									class="unit-pill-mm min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-brand-green text-on-primary hover:bg-brand-green-deep cursor-pointer transition-all flex items-center justify-center"
								>
									g/mol
								</button>
								<button
									type="button"
									data-unit="kg/kmol"
									class="unit-pill-mm min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-transparent border border-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
								>
									kg/kmol
								</button>
							</div>
						</div>
					</div>

					<!-- input-slot-b: permanent shell (layout/divider only). Receives whichever of
					     Mass/Moles is currently the second input — never touched by the move logic
					     itself, only its contents change. -->
					<div id="input-slot-b" class="field-half field-half-divider p-6">
						<div id="mass-field-content" class="h-full flex flex-col justify-between transition-opacity duration-150">
							<div>
								<div class="flex items-center justify-between mb-2">
									<label for="mass-input" class="block text-xs font-semibold uppercase tracking-[0.4px] text-ink-muted">
										Mass
									</label>
								</div>
								<!-- Copy button aligns with the value row (not the label), per Figma's exact position -->
								<div class="relative flex items-center">
									<input
										type="number"
										id="mass-input"
										step="1"
										placeholder="e.g. 18.02"
										class="w-full bg-surface text-ink font-mono text-base rounded-[8px] pl-3 pr-[80px] mobile:pr-[72px] py-[11px] mobile:py-[9px] focus:py-[10px] mobile:focus:py-[8px] border border-hairline focus:outline-none focus:border-2 focus:border-brand-green focus:ring-0 transition-all"
									/>
									<!-- Functional stepper — hidden while this field is the readonly result.
									     See molar-mass-stepper above for the capsule-shape/fill/hit-area
									     rationale — identical component, reused verbatim. -->
									<div id="mass-input-stepper" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center">
										<button type="button" id="mass-step-down" aria-label="Decrease mass" class="hidden group flex items-center justify-center py-2 mobile:py-2.5 cursor-not-allowed focus:outline-none">
											<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-l-full bg-surface-4 text-ink-tertiary transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
												<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
											</span>
										</button>
										<div id="mass-stepper-divider" class="hidden w-px h-8 mobile:h-6 bg-white"></div>
										<button type="button" id="mass-step-up" aria-label="Increase mass" class="group flex items-center justify-center py-2 mobile:py-2.5 cursor-pointer focus:outline-none">
											<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-full bg-surface-4 text-ink-muted transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
												<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
											</span>
										</button>
									</div>
									<!-- Copy Result Button (Shown when readonly) -->
									<button
										type="button"
										id="mass-copy-btn"
										aria-label="Copy mass result"
										disabled
										class="hidden absolute right-0 min-h-[44px] min-w-[44px] items-center justify-center text-ink-tertiary cursor-not-allowed transition-colors"
									>
										<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
										</svg>
									</button>
								</div>
								<!-- Inline Error Message -->
								<div id="mass-error" class="hidden flex items-center gap-2 mt-1 text-sm text-brand-error">
									<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
									<span>Mass cannot be negative</span>
								</div>
							</div>
							<!-- Mass Unit Pills -->
							<div class="mt-4">
								<div class="flex flex-wrap gap-2 items-center" id="mass-units-primary">
									<button
										type="button"
										data-unit="mg"
										class="unit-pill-mass min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-transparent border border-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										mg
									</button>
									<button
										type="button"
										data-unit="g"
										class="unit-pill-mass min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-brand-green text-on-primary hover:bg-brand-green-deep cursor-pointer transition-all flex items-center justify-center"
									>
										g
									</button>
									<button
										type="button"
										data-unit="kg"
										class="unit-pill-mass min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-transparent border border-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										kg
									</button>
									<button
										type="button"
										data-unit="ng"
										class="unit-pill-mass min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-transparent border border-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										ng
									</button>
									<button
										type="button"
										data-unit="ug"
										class="unit-pill-mass min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-transparent border border-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										&micro;g
									</button>
									<button
										type="button"
										data-unit="dag"
										class="unit-pill-mass min-h-[44px] md:min-h-0 px-4 py-[14px] md:px-3 md:py-2 rounded-full text-sm font-medium bg-transparent border border-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										dag
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Browse Elements Trigger + Panel (col-span-2, between inputs and result) -->
				<div class="md:col-span-2">
					<!-- Trigger: trigger-browse-elements -->
					<!--
						`items-start` + the h-5 chevron box pin the chevron to line one, so it
						does not recentre against a wrapped block. `text-left` resets the UA
						button default (`text-align: center`), which Tailwind preflight leaves
						alone. `gap-2` (not gap-1) is sized for the OPEN state: rotating the
						chevron 90° swaps its visual extent, so it overflows its own layout box
						by half the difference and eats into the gap — see the svg below.
					-->
					<button
						id="browse-trigger"
						type="button"
						class="flex items-start gap-2 text-left text-sm text-ink-muted hover:text-ink transition-colors cursor-pointer"
					>
						<span class="flex h-5 shrink-0 items-center">
							<!--
								viewBox maps 1:1 to px, so stroke-width 1.5 renders as exactly
								1.5px. Shrink the glyph by editing the box AND the path together;
								scaling via width/height alone would thin the stroke with it.
							-->
							<svg id="browse-chevron" class="shrink-0 text-ink-muted transition-transform duration-200" width="6" height="10.5" viewBox="0 0 6 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M0.75 9.75L5.25 5.25L0.75 0.75" />
							</svg>
						</span>
						<!--
							One text flow, not two flex children. "Browse elements" is an inline
							span inside the sentence. Both halves are `whitespace-nowrap`, so the
							single space between them is the ONLY soft-wrap opportunity in the
							row — the break can therefore only ever land after the question and
							before the link, at whatever width it lands. A hard <br> would force
							that break at every width, including desktop.
						-->
						<span>
							<span class="whitespace-nowrap">Not sure of the molar mass?</span> <span class="text-ink underline whitespace-nowrap">Browse elements</span>
						</span>
					</button>

					<!-- Collapsible Panel -->
					<div id="browse-panel" class="hidden mt-3 bg-surface-soft border border-hairline rounded-[12px] overflow-hidden">
						<!-- Tabs -->
						<div class="flex border-b border-hairline">
							<button
								id="tab-presets"
								type="button"
								class="py-2 px-4 text-sm font-medium text-brand-green border-b-2 border-brand-green -mb-px transition-colors cursor-pointer"
							>
								Presets
							</button>
							<button
								id="tab-custom"
								type="button"
								class="py-2 px-4 text-sm font-medium text-stone border-b-2 border-transparent -mb-px hover:text-ink transition-colors cursor-pointer"
							>
								Build custom
							</button>
						</div>

						<!-- Presets Tab Content -->
						<div id="panel-presets" class="p-5">
							<label for="preset-select" class="block text-xs font-semibold uppercase tracking-[0.4px] text-ink-subtle mb-2">
								Common Compounds
							</label>
							<select
								id="preset-select"
								class="w-full bg-surface-soft border border-hairline text-ink text-sm font-sans rounded-[8px] px-3.5 py-2.5 focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
							>
								<option value="">Select a compound…</option>
								<optgroup label="Common">
									<option value="18.015">Water (H₂O) — 18.015 g/mol</option>
									<option value="58.44">Table Salt (NaCl) — 58.44 g/mol</option>
									<option value="44.01">Carbon Dioxide (CO₂) — 44.01 g/mol</option>
									<option value="180.16">Glucose (C₆H₁₂O₆) — 180.16 g/mol</option>
									<option value="46.07">Ethanol (C₂H₅OH) — 46.07 g/mol</option>
									<option value="17.031">Ammonia (NH₃) — 17.031 g/mol</option>
									<option value="16.043">Methane (CH₄) — 16.043 g/mol</option>
								</optgroup>
								<optgroup label="Acids &amp; Bases">
									<option value="98.072">Sulfuric Acid (H₂SO₄) — 98.072 g/mol</option>
									<option value="39.997">Sodium Hydroxide (NaOH) — 39.997 g/mol</option>
									<option value="36.458">Hydrochloric Acid (HCl) — 36.458 g/mol</option>
									<option value="60.052">Acetic Acid (CH₃COOH) — 60.052 g/mol</option>
									<option value="63.012">Nitric Acid (HNO₃) — 63.012 g/mol</option>
								</optgroup>
								<optgroup label="Salts &amp; Oxides">
									<option value="84.006">Sodium Bicarbonate (NaHCO₃) — 84.006 g/mol</option>
									<option value="100.086">Calcium Carbonate (CaCO₃) — 100.086 g/mol</option>
									<option value="158.032">Potassium Permanganate (KMnO₄) — 158.032 g/mol</option>
									<option value="120.361">Magnesium Sulfate (MgSO₄) — 120.361 g/mol</option>
									<option value="80.043">Ammonium Nitrate (NH₄NO₃) — 80.043 g/mol</option>
									<option value="101.961">Aluminum Oxide (Al₂O₃) — 101.961 g/mol</option>
									<option value="159.687">Iron(III) Oxide (Fe₂O₃) — 159.687 g/mol</option>
									<option value="159.602">Copper(II) Sulfate (CuSO₄) — 159.602 g/mol</option>
								</optgroup>
							</select>
							<button
								id="use-preset"
								type="button"
								class="hidden mt-3 min-h-[44px] px-5 py-2.5 bg-brand-green text-on-primary text-sm font-medium rounded-full cursor-pointer transition-colors hover:bg-brand-green-deep flex items-center justify-center"
							>
								Use this molar mass
							</button>
						</div>

						<!-- Build Custom Tab Content -->
						<div id="panel-custom" class="hidden p-5">
							<!-- Search -->
							<input
								type="search"
								id="element-search"
								placeholder="Search by name or symbol…"
								class="w-full bg-surface-soft border border-hairline text-ink text-sm font-sans rounded-[8px] px-3.5 py-2.5 mb-4 focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
							/>

							<!-- Element Grid -->
							<div class="element-grid-scroll max-h-[320px] overflow-y-auto rounded-[8px] mb-4">
								<!-- Columns are computed to whole pixels by layoutElementGrid() -->
								<div id="element-grid" class="grid gap-2">
									<!-- Rendered by JS -->
								</div>
							</div>
							<p id="element-grid-empty" class="hidden text-xs text-stone text-center py-4">No elements match your search.</p>

							<!-- Formula Bar -->
