---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mole & Grams-to-Moles Calculator | FreeChemLab">
	<!-- Top Navigation Bar -->
	<header class="w-full bg-canvas border-b border-hairline-soft">
		<div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
			<!-- Logo / Wordmark -->
			<a href="/" class="text-base font-semibold text-ink tracking-tight flex items-center gap-1">
				<span class="text-brand-green font-bold text-lg leading-none">&bull;</span>
				<span>FreeChemLab</span>
			</a>

			<!-- Navigation Item (Active) -->
			<nav aria-label="Main Navigation">
				<ul class="flex items-center space-x-1">
					<li>
						<a
							href="/calculators"
							class="min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 text-sm font-medium text-ink bg-surface rounded-full inset-ring-1 inset-ring-hairline transition-colors flex items-center justify-center"
							aria-current="page"
						>
							Calculator
						</a>
					</li>
				</ul>
			</nav>
		</div>
	</header>

	<main class="w-full max-w-4xl mx-auto px-4 py-4 md:py-6">
		<!-- Breadcrumb Navigation -->
		<nav aria-label="Breadcrumb" class="mb-4">
			<ol class="flex items-center space-x-2 text-sm text-steel">
				<li>
					<a href="/" class="hover:text-ink transition-colors">Home</a>
				</li>
				<li>
					<span class="text-stone" aria-hidden="true">/</span>
				</li>
				<li>
					<a href="/calculators" class="hover:text-ink transition-colors">Calculators</a>
				</li>
				<li>
					<span class="text-stone" aria-hidden="true">/</span>
				</li>
				<li class="font-medium text-ink" aria-current="page">
					Mole &amp; Grams-to-Moles
				</li>
			</ol>
		</nav>

		<!-- Calculator Card Shell -->
		<section class="bg-surface inset-ring-1 inset-ring-hairline rounded-[16px] p-[16px] mobile:p-6">
			<!-- Header Row -->
			<header class="flex flex-col mobile:flex-row mobile:items-center justify-between gap-4 pb-6">
				<div>
					<h1 class="text-xl md:text-2xl font-semibold text-ink tracking-tight">
						Mole &amp; Grams-to-Moles Calculator
					</h1>
				</div>

				<!-- Direction Toggle: toggle-direction, two-word segments joined by a chevron -->
				<div class="inline-flex items-center gap-1 p-1 bg-transparent inset-ring-1 inset-ring-hairline rounded-full self-start mobile:self-auto">
					<button
						id="toggle-g-to-mol"
						type="button"
						class="min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 text-sm font-medium bg-brand-green text-on-primary hover:bg-brand-green-deep rounded-full transition-all cursor-pointer flex items-center gap-1"
					>
						<span>g</span>
						<svg class="shrink-0" width="5.5" height="9.5" viewBox="0 0 5.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M0.75 8.75L4.75 4.75L0.75 0.75" />
						</svg>
						<span>mol</span>
					</button>
					<button
						id="toggle-mol-to-g"
						type="button"
						class="min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 text-sm font-medium text-ink-muted hover:bg-surface-soft hover:text-ink rounded-full transition-all cursor-pointer flex items-center gap-1"
					>
						<span>mol</span>
						<svg class="shrink-0" width="5.5" height="9.5" viewBox="0 0 5.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M0.75 8.75L4.75 4.75L0.75 0.75" />
						</svg>
						<span>g</span>
					</button>
				</div>
			</header>

			<!-- Calculator Inputs & Fields Grid -->
			<div class="flex flex-col gap-6">
				<!-- Molar Mass + Mass: card-field, merged into one card (no gap, no divider) —
				     split by asymmetric padding: 24px outer edges, 12px on the shared midline -->
				<div class="field-row w-full bg-surface-soft inset-ring-1 inset-ring-hairline rounded-[12px] flex flex-col">
					<!-- Molar Mass: input-slot-a. Permanent — always the first input, never moves,
					     never re-parented. Must stay the literal first child of .field-row (the
					     520px+ padding-right rule targets :first-child). -->
					<div id="input-slot-a" class="field-half flex flex-col justify-start p-[16px] mobile:p-6">
						<div>
							<div class="flex items-center justify-between mb-2">
								<label for="molar-mass" class="block text-xs font-semibold uppercase tracking-[0.4px] text-ink-muted">
									Molar Mass
								</label>
							</div>
							<div class="relative flex items-center">
								<!-- Molar Mass mode: fused dropdown + input (stage 1 of a multi-stage
								     rebuild — see DESIGN.md screenshots). The wrapper, not the input,
								     now carries the border/radius/focus-ring/error-ring, since a second
								     control (the mode trigger) shares its edge — the error/clear-error
								     JS below was retargeted from #molar-mass to #molar-mass-mode-wrapper
								     accordingly. This stage wires only the dropdown shell and
								     mode-switching state (activeMolarMassMode, in the second <script>
								     block below, next to #preset-listbox whose combobox/listbox pattern
								     it reuses). Selecting "Build custom" now reveals its element picker
								     (#molar-mass-build-panel, stage 3, just below this card);
								     "Compounds" still has no panel (stage 4). Neither touches the
								     existing "Browse elements" accordion further down, which stays
								     fully functional until stage 5's teardown. -->
								<div id="molar-mass-mode-wrapper" class="flex items-stretch w-full rounded-[8px] overflow-hidden inset-ring-1 inset-ring-hairline focus-within:inset-ring-2 focus-within:inset-ring-primary transition-all">
									<button
										type="button"
										id="molar-mass-mode-trigger"
										role="combobox"
										aria-haspopup="listbox"
										aria-expanded="false"
										aria-controls="molar-mass-mode-listbox"
										aria-label="Molar mass input mode"
										class="shrink-0 flex items-center gap-1.5 bg-surface-3 text-ink text-sm font-sans pl-3 pr-2.5 py-[12px] mobile:py-[10px] border-r border-hairline cursor-pointer focus:outline-none"
									>
										<span id="molar-mass-mode-label">Type in</span>
										<svg class="pointer-events-none shrink-0 rotate-90 text-ink-muted" width="6" height="10.5" viewBox="0 0 6 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
											<path d="M0.75 9.75L5.25 5.25L0.75 0.75" />
										</svg>
									</button>
									<input
										type="number"
										id="molar-mass"
										step="1"
										placeholder="e.g. 18.02"
										class="flex-1 min-w-0 bg-surface text-ink font-mono text-base pl-3 pr-[80px] mobile:pr-[72px] py-[12px] mobile:py-[10px] focus:outline-none focus:ring-0 transition-all"
									/>
								</div>
								<!-- Mode listbox popup — same `position: fixed`-off-trigger-rect pattern
								     as #preset-listbox (see that element's comment for why: it escapes
								     #browse-panel's overflow-hidden clip and repositions rather than
								     closing on scroll/resize). -->
								<div
									id="molar-mass-mode-listbox"
									role="listbox"
									aria-label="Molar mass input mode options"
									tabindex="-1"
									class="hidden fixed z-20 overflow-y-auto bg-surface-1 inset-ring-1 inset-ring-hairline rounded-[8px] py-1"
								></div>
								<!-- Functional stepper — one capsule, not two circles. Rounding is per-side,
								     not per-button: "-" is permanently rounded-l-full/square-right (it never
								     appears without "+" beside it), "+" is rounded-full (full circle) while
								     alone and switches to rounded-r-full/square-left the moment "-" mounts —
								     toggled in updateStepperState alongside its other state classes. The two
								     chips sit flush (the row has no `gap-*`), so the only seam is the 1px
								     white divider; nothing else may add a gap or the capsule silhouette
								     breaks apart into two circles again. Fill lives per-button on each
								     painted chip (bg-surface-4 default) — 24×24 at `mobile:` (≥520px) and up,
								     32×32 below it — not on a shared pill background. No border in any state.
								     Hover/pressed are wrapped in an explicit `(hover: hover)` media condition
								     (Tailwind's own `hover:`/`group-hover:` already carry that scoping by
								     default — see DESIGN.md — but `active`/`group-active` do not, so pressed
								     is scoped explicitly) so touch taps never show a stuck hover/press fill.
								     Right-anchored (not left): the row's width is intrinsic to its visible
								     children, so hiding/showing "-" and the divider changes the LEFT edge
								     only — "+" stays pinned to the same x position at every value, by
								     construction. Each button paints small but hit-tests the input's full
								     height — 48px below 520px, 44px at/above it: `py-2` (mobile) /
								     `mobile:py-2.5` (desktop) on the transparent outer `<button>` makes up
								     the difference against the 32px/24px chip. Both the chip and the input
								     grew by 4px on mobile in the same change, so this padding pair is
								     unchanged from the 28px-chip/44px-input generation — same "hit area
								     independent of painted size" pattern as the element-grid stepper
								     (`element-tile-stepper-button`). -->
								<div id="molar-mass-stepper" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center">
									<button type="button" id="molar-mass-step-down" aria-label="Decrease molar mass" class="hidden group flex items-center justify-center py-2 mobile:py-2.5 cursor-not-allowed focus:outline-none">
										<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-l-full bg-surface-4 text-ink-tertiary transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
											<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</span>
									</button>
									<div id="molar-mass-stepper-divider" class="hidden w-px h-8 mobile:h-6 bg-white"></div>
									<button type="button" id="molar-mass-step-up" aria-label="Increase molar mass" class="group flex items-center justify-center py-2 mobile:py-2.5 cursor-pointer focus:outline-none">
										<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-full bg-surface-4 text-ink-muted transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
											<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</span>
									</button>
								</div>
							</div>
							<!-- Inline Error Message -->
							<div id="molar-mass-error" class="hidden flex items-center gap-2 mt-1 text-sm text-brand-error">
								<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
								<span>Molar mass must be greater than 0</span>
							</div>
						</div>
						<!-- Molar Mass Unit Pills -->
						<div class="mt-4">
							<div class="flex flex-wrap gap-2 items-center" id="molar-mass-units">
								<button
									type="button"
									data-unit="g/mol"
									class="unit-pill-mm min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-brand-green text-on-primary hover:bg-brand-green-deep cursor-pointer transition-all flex items-center justify-center"
								>
									g/mol
								</button>
								<button
									type="button"
									data-unit="kg/kmol"
									class="unit-pill-mm min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
								>
									kg/kmol
								</button>
							</div>
						</div>
					</div>

					<!-- input-slot-b: permanent shell (layout/divider only). Receives whichever of
					     Mass/Moles is currently the second input — never touched by the move logic
					     itself, only its contents change. -->
					<div id="input-slot-b" class="field-half field-half-divider p-[16px] mobile:p-6">
						<div id="mass-field-content" class="h-full flex flex-col justify-start transition-opacity duration-150">
							<div>
								<div class="flex items-center justify-between mb-2">
									<label for="mass-input" class="block text-xs font-semibold uppercase tracking-[0.4px] text-ink-muted">
										Mass
									</label>
								</div>
								<!-- Copy button aligns with the value row (not the label), per Figma's exact position -->
								<div class="relative flex items-center">
									<input
										type="number"
										id="mass-input"
										step="1"
										placeholder="e.g. 18.02"
										class="w-full bg-surface text-ink font-mono text-base rounded-[8px] pl-3 pr-[80px] mobile:pr-[72px] py-[12px] mobile:py-[10px] inset-ring-1 inset-ring-hairline focus:outline-none focus:inset-ring-2 focus:inset-ring-primary focus:ring-0 transition-all"
									/>
									<!-- Functional stepper — hidden while this field is the readonly result.
									     See molar-mass-stepper above for the capsule-shape/fill/hit-area
									     rationale — identical component, reused verbatim. -->
									<div id="mass-input-stepper" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center">
										<button type="button" id="mass-step-down" aria-label="Decrease mass" class="hidden group flex items-center justify-center py-2 mobile:py-2.5 cursor-not-allowed focus:outline-none">
											<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-l-full bg-surface-4 text-ink-tertiary transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
												<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
											</span>
										</button>
										<div id="mass-stepper-divider" class="hidden w-px h-8 mobile:h-6 bg-white"></div>
										<button type="button" id="mass-step-up" aria-label="Increase mass" class="group flex items-center justify-center py-2 mobile:py-2.5 cursor-pointer focus:outline-none">
											<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-full bg-surface-4 text-ink-muted transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
												<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
											</span>
										</button>
									</div>
									<!-- Copy Result Button (Shown when readonly) -->
									<button
										type="button"
										id="mass-copy-btn"
										aria-label="Copy mass result"
										disabled
										class="hidden absolute right-0 min-h-[44px] min-w-[44px] items-center justify-center text-ink-tertiary cursor-not-allowed transition-colors"
									>
										<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
										</svg>
									</button>
								</div>
								<!-- Inline Error Message -->
								<div id="mass-error" class="hidden flex items-center gap-2 mt-1 text-sm text-brand-error">
									<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
									<span>Mass cannot be negative</span>
								</div>
							</div>
							<!-- Mass Unit Pills -->
							<div class="mt-4">
								<div class="flex flex-wrap gap-2 items-center" id="mass-units-primary">
									<button
										type="button"
										data-unit="mg"
										class="unit-pill-mass min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										mg
									</button>
									<button
										type="button"
										data-unit="g"
										class="unit-pill-mass min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-brand-green text-on-primary hover:bg-brand-green-deep cursor-pointer transition-all flex items-center justify-center"
									>
										g
									</button>
									<button
										type="button"
										data-unit="kg"
										class="unit-pill-mass min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										kg
									</button>
									<button
										type="button"
										data-unit="ng"
										class="unit-pill-mass min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										ng
									</button>
									<button
										type="button"
										data-unit="ug"
										class="unit-pill-mass min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										&micro;g
									</button>
									<button
										type="button"
										data-unit="dag"
										class="unit-pill-mass min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center"
									>
										dag
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Build custom element picker (stage 3 of the Molar Mass mode rebuild).
				     An OVERLAY, not an in-flow block: `position: fixed`, anchored under the
				     Molar Mass control and spanning the full content width of the card above
				     (both halves), so it floats over the unit pills, the Mass field's lower
				     half and whatever follows the card — it does not push the page down. Its
				     DOM position here is incidental: out-of-flow, so it is neither a flex
				     item of this column nor subject to its `gap-6`. It sits here rather than
				     inside #input-slot-a because that slot is under half the card's width on
				     desktop, and the grid solves for whole-pixel columns no narrower than
				     222px (GRID_MIN_COL, the "Molybdenum" + stepper truncation floor) — the
				     card-wide span is what keeps it 3-up instead of collapsing to 1-up.

				     Geometry is computed in positionMolarMassBuildPanel(), not declared:
				     the left edge and the width are derived from .field-row's rect and the
				     card's own outer padding (24px at `mobile:`, 16px below), which is also
				     the Molar Mass control's left inset — so the panel lines up with that
				     control on the left and with the Mass field on the right at both
				     breakpoints, without restating either padding value here. `fixed` (with
				     scroll/resize reposition) rather than `absolute` for the same reason
				     #preset-listbox uses it — see that element's comment.

				     This is a SECOND, INDEPENDENT instance of the same element-grid
				     component the "Browse elements" accordion's Build-custom tab renders
				     (createElementGrid() in the script below) — same tiles, same steppers,
				     same column math, its own quantities Map. The two never share a
				     selection: this one's writes go to the build-custom mode slot, the
				     old one's still go through #use-custom, and the old tab keeps working
				     untouched until stage 5 removes it.

				     No "Use this molar mass" confirm button, unlike the accordion tab this
				     otherwise mirrors: #molar-mass is a live view onto the build-custom slot
				     (stage 2), so every tile click already lands in the field and there is
				     nothing left for a confirm step to do. The Formula/Molar Mass readout
				     pair the accordion's formula bar carries is kept as-is — z-10, under the
				     mode listbox's z-20, so opening the mode dropdown still draws over it. -->
				<div id="molar-mass-build-panel" class="hidden fixed z-10 bg-surface-soft inset-ring-1 inset-ring-hairline rounded-[12px] p-[16px] mobile:p-5">
					<input
						type="search"
						id="molar-mass-element-search"
						aria-label="Search elements"
						placeholder="Search by name or symbol…"
						class="w-full bg-surface-soft inset-ring-1 inset-ring-hairline text-ink text-sm font-sans rounded-[8px] pl-3 pr-3 py-[12px] mobile:py-[10px] mb-4 focus:outline-none focus:inset-ring-primary focus:ring-1 focus:ring-brand-green transition-all"
					/>

					<div id="molar-mass-element-grid-scroll" class="element-grid-scroll max-h-[320px] overflow-y-auto rounded-[8px] mb-4">
						<!-- Columns are computed to whole pixels by this instance's layout() -->
						<div id="molar-mass-element-grid" class="grid gap-2">
							<!-- Rendered by JS -->
						</div>
					</div>
					<p id="molar-mass-element-grid-empty" class="hidden text-xs text-stone text-center py-4">No elements match your search.</p>

					<!-- Same Formula / Molar Mass pair as the accordion tab's formula bar,
					     minus its "Use this molar mass" button. With the button gone the two
					     readouts fit side by side at every width, so this drops that bar's
					     `flex-col mobile:flex-row` stack — there is no third item to make
					     room for below 520px. -->
					<div class="mt-4 pt-4 border-t border-hairline-soft flex items-center justify-between gap-3">
						<div>
							<span class="block text-xs font-semibold uppercase tracking-[0.4px] text-ink-subtle mb-2">Formula</span>
							<span id="molar-mass-custom-formula" class="text-base font-medium font-mono text-ink">—</span>
						</div>
						<div class="text-right">
							<span class="block text-xs font-semibold uppercase tracking-[0.4px] text-ink-subtle mb-2">Molar Mass</span>
							<span id="molar-mass-custom-mass" class="text-base font-medium font-mono text-ink">—</span>
						</div>
					</div>
				</div>

				<!-- Compounds picker (stage 4). Same overlay slot and the same geometry as
				     #molar-mass-build-panel above — both are placed by
				     positionMolarMassModePanel(), so they line up with the Molar Mass
				     control on the left and the Mass field on the right at both
				     breakpoints, and neither is in flow.

				     Unlike the Build-custom panel this has no container of its own: the
				     panel IS the listbox, carrying #preset-listbox's own popup styling
				     (bg-surface-1 a step above the card it floats over, hairline ring,
				     max-h-72 + overflow-y-auto). Its options and group headings are built
				     by createPresetListbox() from the same PRESETS/PRESET_GROUP_ORDER the
				     accordion's Presets tab reads — one component, two instances, no second
				     copy of the compound list.

				     tabindex="0" and role="listbox" here, where the accordion's equivalent
				     is tabindex="-1": that one is the popup half of a combobox, so focus
				     stays on #preset-trigger and this element is never a tab stop. This one
				     has no trigger — the mode dropdown already chose "Compounds", and a
				     second collapsed control to expand would be a redundant step — so it is
				     the focusable element itself, and carries aria-activedescendant
				     directly (ARIA APG "Listbox", not "Combobox"). Its focus ring is the
				     only `focus-visible:` in the app, which is otherwise all `focus:`:
				     every other focusable here is an input or a button, where a ring on
				     click reads as normal, but clicking an option focuses this whole
				     ~280px panel and a 2px green ring around all of it is both louder than
				     anything else on the page and absent from the mockup. `focus-visible:`
				     keeps the keyboard affordance and drops the pointer-only case. There is no confirm
				     step: a click or Enter writes the compounds slot, which stage 2 pushes
				     straight into #molar-mass. -->
				<div
					id="molar-mass-compounds-panel"
					role="listbox"
					aria-label="Common compounds"
					tabindex="0"
					class="hidden fixed z-10 max-h-72 overflow-y-auto bg-surface-1 inset-ring-1 inset-ring-hairline rounded-[8px] py-1 focus:outline-none focus-visible:inset-ring-2 focus-visible:inset-ring-primary"
				></div>

				<!-- Browse Elements Trigger + Panel (col-span-2, between inputs and result) -->
				<div class="md:col-span-2">
					<!-- Trigger: trigger-browse-elements -->
					<!--
						`items-start` + the h-5 chevron box pin the chevron to line one, so it
						does not recentre against a wrapped block. `text-left` resets the UA
						button default (`text-align: center`), which Tailwind preflight leaves
						alone. `gap-2` (not gap-1) is sized for the OPEN state: rotating the
						chevron 90° swaps its visual extent, so it overflows its own layout box
						by half the difference and eats into the gap — see the svg below.
					-->
					<button
						id="browse-trigger"
						type="button"
						class="flex items-start gap-2 text-left text-sm text-ink-muted hover:text-ink transition-colors cursor-pointer"
					>
						<span class="flex h-5 shrink-0 items-center">
							<!--
								viewBox maps 1:1 to px, so stroke-width 1.5 renders as exactly
								1.5px. Shrink the glyph by editing the box AND the path together;
								scaling via width/height alone would thin the stroke with it.
							-->
							<svg id="browse-chevron" class="shrink-0 text-ink-muted transition-transform duration-200" width="6" height="10.5" viewBox="0 0 6 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M0.75 9.75L5.25 5.25L0.75 0.75" />
							</svg>
						</span>
						<!--
							One text flow, not two flex children. "Browse elements" is an inline
							span inside the sentence. Both halves are `whitespace-nowrap`, so the
							single space between them is the ONLY soft-wrap opportunity in the
							row — the break can therefore only ever land after the question and
							before the link, at whatever width it lands. A hard <br> would force
							that break at every width, including desktop.
						-->
						<span>
							<span class="whitespace-nowrap">Not sure of the molar mass?</span> <span class="text-ink underline whitespace-nowrap">Browse elements</span>
						</span>
					</button>

					<!-- Collapsible Panel -->
					<div id="browse-panel" class="hidden mt-3 bg-surface-soft inset-ring-1 inset-ring-hairline rounded-[12px] overflow-hidden">
						<!-- Tabs -->
