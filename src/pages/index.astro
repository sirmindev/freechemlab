</Layout>

<style>
	/* Responsive breakpoint: 520px per DESIGN.md */

	/* card-field: Molar Mass and Mass stack (mobile) or sit side by side (520px+),
	   sharing one card with no gap — a hairline divider stands in for the gap when stacked. */
	.field-half {
		flex: 1 1 0%;
		min-width: 0;
	}
	.field-half-divider {
		border-top: 0.5px solid var(--color-hairline-soft);
	}

	@media (min-width: 520px) {
		.field-row {
			flex-direction: row;
		}
		.field-half:first-child {
			padding-right: 12px;
		}
		.field-half-divider {
			padding-left: 12px;
			border-top: none;
		}
	}
</style>

<script>
	import {
		calculateMolesWithUnits,
		calculateMassWithUnits,
		toBaseMoles,
		calculateParticles,
		formatParticleCount,
		format6Decimals,
		type MolarMassUnit,
		type MassUnit,
		type MolesUnit
	} from '../utils/units';

	let currentMode: 'g_to_mol' | 'mol_to_g' = 'g_to_mol';

	let molarMassUnit: MolarMassUnit = 'g/mol';
	let massUnit: MassUnit = 'g';
	let molesUnit: MolesUnit = 'mol';

	const toggleGtoMolBtn = document.getElementById('toggle-g-to-mol');
	const toggleMolToGBtn = document.getElementById('toggle-mol-to-g');

	const molarMassInput = document.getElementById('molar-mass') as HTMLInputElement | null;
	// The border/radius/focus-ring/error-ring live here now, not on #molar-mass
	// itself — see the markup comment above #molar-mass-mode-wrapper.
	const molarMassFieldWrapper = document.getElementById('molar-mass-mode-wrapper');
	const molarMassError = document.getElementById('molar-mass-error');
	const molarMassStepUp = document.getElementById('molar-mass-step-up') as HTMLButtonElement | null;
	const molarMassStepDown = document.getElementById('molar-mass-step-down') as HTMLButtonElement | null;
	const molarMassStepperDivider = document.getElementById('molar-mass-stepper-divider');

	const massInput = document.getElementById('mass-input') as HTMLInputElement | null;
	const massError = document.getElementById('mass-error');
	const massInputStepper = document.getElementById('mass-input-stepper');
	const massStepUp = document.getElementById('mass-step-up') as HTMLButtonElement | null;
	const massStepDown = document.getElementById('mass-step-down') as HTMLButtonElement | null;
	const massStepperDivider = document.getElementById('mass-stepper-divider');
	const massCopyBtn = document.getElementById('mass-copy-btn') as HTMLButtonElement | null;

	const molesInput = document.getElementById('moles-input') as HTMLInputElement | null;
	const molesError = document.getElementById('moles-error');
	const molesInputStepper = document.getElementById('moles-input-stepper');
	const molesStepUp = document.getElementById('moles-step-up') as HTMLButtonElement | null;
	const molesStepDown = document.getElementById('moles-step-down') as HTMLButtonElement | null;
	const molesStepperDivider = document.getElementById('moles-stepper-divider');
	const molesCopyBtn = document.getElementById('moles-copy-btn') as HTMLButtonElement | null;

	const particleCountRow = document.getElementById('particle-count-row');
	const particleCountVal = document.getElementById('particle-count-val');

	// Permanent slots (never move) vs. movable field-content fragments (Mass/Moles swap
	// between these two on toggle; Molar Mass always stays in #input-slot-a, untouched).
	const inputSlotB = document.getElementById('input-slot-b');
	const resultSlot = document.getElementById('result-slot');
	const massFieldContent = document.getElementById('mass-field-content');
	const molesFieldContent = document.getElementById('moles-field-content');

	// The string a result field displays is a rendering, not a value: format6Decimals
	// pads to 6 decimals ("1.000000") or drops to 4 significant figures ("1.000e-12").
	// Keep the unrounded number alongside it so that when a field flips to the input
	// role it can be restored from the number rather than inheriting read-only display
	// formatting. null = no valid result is currently displayed for that field.
	let lastMassResult: number | null = null;
	let lastMolesResult: number | null = null;

	interface FieldRefs {
		input: HTMLInputElement | null;
		stepper: HTMLElement | null;
		copyBtn: HTMLButtonElement | null;
		editablePlaceholder: string;
		rawResult: number | null;
	}

	const EDITABLE_INPUT_CLASS = "w-full bg-surface text-ink font-mono text-base rounded-[8px] pl-3 pr-[80px] mobile:pr-[72px] py-[12px] mobile:py-[10px] inset-ring-1 inset-ring-hairline focus:outline-none focus:inset-ring-2 focus:inset-ring-primary focus:ring-0 transition-all";
	// result-value: bare typography, no box — the absence of a box is the read-only signal (see DESIGN.md Don't)
	const READONLY_RESULT_CLASS = "w-full bg-transparent text-ink-tertiary font-mono text-[32px] font-medium rounded-none border-0 px-0 py-0 cursor-not-allowed select-none focus:outline-none transition-all";

	// <input type="number"> silently rejects a non-numeric value like '—', falling back to
	// whatever placeholder is set — so the placeholder must itself read as a neutral empty
	// result (not the editable field's "e.g." hint) whenever the field is the readonly result.
	const MASS_EDITABLE_PLACEHOLDER = "e.g. 18.02";
	const MOLES_EDITABLE_PLACEHOLDER = "e.g. 0.05";
	const RESULT_PLACEHOLDER = "0.000000";

	// Renders a restored result for display in an editable field. Goes through
	// format6Decimals so a restored value reads the same as every other computed
	// number in the app (Molar Mass excepted — that's a raw typed echo, never
	// reformatted), then round-trips via parseFloat to drop the zeros it pads on,
	// keeping 1 as "1" rather than "1.000000". Rounding here is safe only because
	// the pin below preserves the full float for calculation.
	function toEditableValue(value: number): string {
		return String(parseFloat(format6Decimals(value)));
	}

	// The displayed string is display only. Since recalculate() reads the input
	// field, rounding alone would also round the calculation and reintroduce drift
	// (molar mass 3 came back as 0.999999999999 when the field was the only copy).
	// So pin the UNROUNDED float against the shortened string and read the number
	// back for as long as the field still shows exactly what we wrote — any edit
	// changes it and retires the pin.
	const displayPins = new Map<HTMLInputElement, { shown: string; value: number }>();

	function readFieldNumber(input: HTMLInputElement | null): number {
		const raw = input?.value ?? '';
		const pin = input ? displayPins.get(input) : undefined;
		return pin && pin.shown === raw ? pin.value : parseFloat(raw);
	}

	// Generic role assignment — replaces what used to be two mirrored mass-specific/
	// moles-specific branches. Molar Mass never calls this: it's permanently 'input',
	// fixed in #input-slot-a, and isn't part of this state machine at all.
	function setFieldRole(refs: FieldRefs, role: 'input' | 'result') {
		if (refs.input) {
			if (role === 'input') {
				refs.input.readOnly = false;
				refs.input.className = EDITABLE_INPUT_CLASS;
				// Clear the inline line-height the result role sets (and that Moles
				// also ships in its static markup). An inline style outranks the
				// class-based line-height, so without this the field keeps the
				// result's 1.2 — 19.2px of content instead of 24px — and renders
				// ~4.8px shorter than every other editable input. Pre-existing:
				// editable Moles measured 39.19px against Molar Mass/Mass at 44px.
				refs.input.style.lineHeight = '';
				refs.input.placeholder = refs.editablePlaceholder;
				// Shed the display formatting this field carried as a result. Restoring
				// from the number (not re-parsing the rounded string) keeps a back-and-
				// forth toggle lossless. null means the result was empty — leave the
				// field empty rather than inventing a value.
				if (refs.rawResult !== null) {
					const shown = toEditableValue(refs.rawResult);
					refs.input.value = shown;
					displayPins.set(refs.input, { shown, value: refs.rawResult });
				}
			} else {
				displayPins.delete(refs.input);
				refs.input.readOnly = true;
				refs.input.className = READONLY_RESULT_CLASS;
				refs.input.style.lineHeight = "1.2";
				refs.input.placeholder = RESULT_PLACEHOLDER;
			}
		}
		refs.stepper?.classList.toggle('hidden', role === 'result');
		refs.copyBtn?.classList.toggle('hidden', role === 'input');
	}

	// Moves an already-in-DOM field-content fragment into a new slot (appendChild
	// relocates, it doesn't clone — event listeners and the input's current value
	// survive the move untouched) with a brief opacity fade, per DESIGN.md's
	// documented 150-200ms default. Never call this on initial page load — only on
	// an actual toggle — so first paint never flashes invisible content.
	function moveFieldTo(fragment: HTMLElement | null, targetSlot: HTMLElement | null) {
		if (!fragment || !targetSlot || fragment.parentElement === targetSlot) return;
		fragment.classList.add('opacity-0');
		targetSlot.appendChild(fragment);
		requestAnimationFrame(() => {
			fragment.classList.remove('opacity-0');
		});
	}

	// Physically re-parents Mass/Moles between the input slot and the result slot.
	// Only called from the toggle click handlers, never on initial render.
	function assignFieldPositions() {
		if (currentMode === 'g_to_mol') {
			moveFieldTo(massFieldContent, inputSlotB);
			moveFieldTo(molesFieldContent, resultSlot);
		} else {
			moveFieldTo(molesFieldContent, inputSlotB);
			moveFieldTo(massFieldContent, resultSlot);
		}
	}

	function updateModeUI() {
		clearAllErrors();

		const massRefs: FieldRefs = { input: massInput, stepper: massInputStepper, copyBtn: massCopyBtn, editablePlaceholder: MASS_EDITABLE_PLACEHOLDER, rawResult: lastMassResult };
		const molesRefs: FieldRefs = { input: molesInput, stepper: molesInputStepper, copyBtn: molesCopyBtn, editablePlaceholder: MOLES_EDITABLE_PLACEHOLDER, rawResult: lastMolesResult };

		if (currentMode === 'g_to_mol') {
			// g -> mol: Mass is input (alongside Molar Mass), Moles is the readonly result
			toggleGtoMolBtn?.classList.add('bg-brand-green', 'text-on-primary', 'hover:bg-brand-green-deep');
			toggleGtoMolBtn?.classList.remove('text-ink-muted');
			toggleMolToGBtn?.classList.remove('bg-brand-green', 'text-on-primary', 'hover:bg-brand-green-deep');
			toggleMolToGBtn?.classList.add('text-ink-muted');

			setFieldRole(massRefs, 'input');
			setFieldRole(molesRefs, 'result');

			particleCountRow?.classList.remove('hidden');
			particleCountRow?.classList.add('flex');
			updateStepperState(massInput, massStepDown, massStepUp, massStepperDivider);
		} else {
			// mol -> g: Moles is input (alongside Molar Mass), Mass is the readonly result
			toggleMolToGBtn?.classList.add('bg-brand-green', 'text-on-primary', 'hover:bg-brand-green-deep');
			toggleMolToGBtn?.classList.remove('text-ink-muted');
			toggleGtoMolBtn?.classList.remove('bg-brand-green', 'text-on-primary', 'hover:bg-brand-green-deep');
			toggleGtoMolBtn?.classList.add('text-ink-muted');

			setFieldRole(molesRefs, 'input');
			setFieldRole(massRefs, 'result');

			particleCountRow?.classList.add('hidden');
			particleCountRow?.classList.remove('flex');
			updateStepperState(molesInput, molesStepDown, molesStepUp, molesStepperDivider);
		}
		recalculate();
	}

	// Error and focus both swap the inset-ring width (1px -> 2px) alongside the
	// color. box-shadow:inset never participates in box sizing, so unlike a
	// real border this never shifts the input's height — no padding trade
	// needed. Focus does the swap via pure CSS (`focus:` variants baked into
	// EDITABLE_INPUT_CLASS); error needs it done in JS because it's a toggled
	// class, not a pseudo-class.
	function clearAllErrors() {
		molarMassError?.classList.add('hidden');
		molarMassFieldWrapper?.classList.remove('inset-ring-error', 'inset-ring-2');
		molarMassFieldWrapper?.classList.add('inset-ring-hairline', 'inset-ring-1');

		// Only reset the hairline ring on mass/moles when they're the editable
		// text-input — the readonly result-value has no box, and re-adding a
		// border here would silently restore it (see DESIGN.md's read-only Don't).
		massError?.classList.add('hidden');
		if (massInput && !massInput.readOnly) {
			massInput.classList.remove('inset-ring-error', 'inset-ring-2');
			massInput.classList.add('inset-ring-hairline', 'inset-ring-1');
		}

		molesError?.classList.add('hidden');
		if (molesInput && !molesInput.readOnly) {
			molesInput.classList.remove('inset-ring-error', 'inset-ring-2');
			molesInput.classList.add('inset-ring-hairline', 'inset-ring-1');
		}
	}

	// Empty-state text (result value, particle count, copy icon) shares ink-tertiary;
	// filled state restores each element's own color. See DESIGN.md's result-empty.
	function setResultTextState(el: HTMLElement | null, hasValue: boolean, filledClass: string) {
		if (!el) return;
		if (hasValue) {
			el.classList.remove('text-ink-tertiary');
			el.classList.add(filledClass);
		} else {
			el.classList.remove(filledClass);
			el.classList.add('text-ink-tertiary');
		}
	}

	function setCopyButtonState(button: HTMLButtonElement | null, hasValue: boolean) {
		if (!button) return;
		button.disabled = !hasValue;
		if (hasValue) {
			button.classList.remove('text-ink-tertiary', 'cursor-not-allowed');
			button.classList.add('text-ink-muted', 'cursor-pointer');
		} else {
			button.classList.remove('text-ink-muted', 'cursor-pointer');
			button.classList.add('text-ink-tertiary', 'cursor-not-allowed');
		}
	}

	// Functional stepper (replaces the native spinner). Floor is 0 for all three
	// fields — molar mass separately shows a validation error at exactly 0, the
	// stepper itself just won't go negative.
	//
	// "-" (and its divider) only exist in the DOM's visible flow once there's a
	// positive value to decrement — negative molar mass/mass/moles has no
	// physical meaning, so a value of exactly 0 (or empty) collapses the pill
	// to a single "+" circle rather than showing a "-" that could only ever be
	// disabled. This is deliberately keyed to `current > 0`, not "any non-empty
	// input" — typing "0" explicitly still collapses to "+"-only.
	function updateStepperState(input: HTMLInputElement | null, downBtn: HTMLButtonElement | null, upBtn: HTMLButtonElement | null, divider?: HTMLElement | null) {
		if (!input || !downBtn || !upBtn) return;
		// The painted chip (fill + glyph color) lives on the button's inner <span>,
		// not the button itself — the button is the transparent hit-area carrier
		// (see field-stepper-pill markup). Only the chip's text color needs to
		// swap between enabled/disabled; its hover/pressed fill classes are static
		// and simply never trigger while the button carries `disabled`.
		const chip = downBtn.firstElementChild as HTMLElement | null;
		const upChip = upBtn.firstElementChild as HTMLElement | null;
		const step = parseFloat(input.step) || 1;
		const current = input.value === '' ? 0 : parseFloat(input.value);
		const hasValue = !isNaN(current) && current > 0;
		downBtn.classList.toggle('hidden', !hasValue);
		divider?.classList.toggle('hidden', !hasValue);
		// "+" is a full circle while it's alone; the moment "-" mounts beside it,
		// it drops to right-only rounding so the pair reads as one capsule split
		// by the divider, not two independent circles with a gap between them.
		upChip?.classList.toggle('rounded-full', !hasValue);
		upChip?.classList.toggle('rounded-r-full', hasValue);

		const disabled = isNaN(current) || current - step < 0;
		downBtn.disabled = disabled;
		downBtn.classList.toggle('cursor-not-allowed', disabled);
		downBtn.classList.toggle('cursor-pointer', !disabled);
		chip?.classList.toggle('text-ink-tertiary', disabled);
		chip?.classList.toggle('text-ink-muted', !disabled);
	}

	function stepInput(input: HTMLInputElement | null, direction: 'up' | 'down') {
		if (!input || input.readOnly) return;
		const step = parseFloat(input.step) || 1;
		const current = input.value === '' ? 0 : parseFloat(input.value);
		if (isNaN(current)) return;
		const next = direction === 'up' ? current + step : Math.max(0, current - step);
		input.value = String(Math.round(next * 100) / 100);
		input.dispatchEvent(new Event('input', { bubbles: true }));
	}

	function recalculate() {
		clearAllErrors();

		const rawMolarMass = molarMassInput?.value ?? '';
		const molarMassVal = parseFloat(rawMolarMass);
		let hasError = false;

		// Molar mass validation: must be greater than 0
		if (rawMolarMass.trim() !== '' && (isNaN(molarMassVal) || molarMassVal <= 0)) {
			if (molarMassError) {
				molarMassError.classList.remove('hidden');
			}
			molarMassFieldWrapper?.classList.add('inset-ring-error', 'inset-ring-2');
			molarMassFieldWrapper?.classList.remove('inset-ring-hairline', 'inset-ring-1');
			hasError = true;
		}

		if (currentMode === 'g_to_mol') {
			const rawMass = massInput?.value ?? '';
			const massVal = readFieldNumber(massInput);

			// Mass validation: must be non-negative
			if (rawMass.trim() !== '' && (isNaN(massVal) || massVal < 0)) {
				if (massError) {
					massError.classList.remove('hidden');
				}
				massInput?.classList.add('inset-ring-error', 'inset-ring-2');
				massInput?.classList.remove('inset-ring-hairline', 'inset-ring-1');
				hasError = true;
			}

			if (hasError || rawMolarMass.trim() === '' || rawMass.trim() === '' || isNaN(molarMassVal) || molarMassVal <= 0 || isNaN(massVal) || massVal < 0) {
				lastMolesResult = null;
				if (molesInput) molesInput.value = '—';
				if (particleCountVal) particleCountVal.textContent = '0 particles';
				setCopyButtonState(molesCopyBtn, false);
				setResultTextState(molesInput, false, 'text-primary');
				setResultTextState(particleCountVal, false, 'text-ink');
				return;
			}

			const molesResult = calculateMolesWithUnits(
				massVal,
				massUnit,
				molarMassVal,
				molarMassUnit,
				molesUnit
			);
			lastMolesResult = molesResult;
			if (molesInput) molesInput.value = format6Decimals(molesResult);
			setCopyButtonState(molesCopyBtn, true);
			setResultTextState(molesInput, true, 'text-primary');

			// Calculate particle count
			const molesInMol = toBaseMoles(molesResult, molesUnit);
			const particles = calculateParticles(molesInMol);
			if (particleCountVal) particleCountVal.textContent = formatParticleCount(particles);
			setResultTextState(particleCountVal, true, 'text-ink');
		} else {
			const rawMoles = molesInput?.value ?? '';
			const molesVal = readFieldNumber(molesInput);

			// Moles validation: must be non-negative
			if (rawMoles.trim() !== '' && (isNaN(molesVal) || molesVal < 0)) {
				if (molesError) {
					molesError.classList.remove('hidden');
				}
				molesInput?.classList.add('inset-ring-error', 'inset-ring-2');
				molesInput?.classList.remove('inset-ring-hairline', 'inset-ring-1');
				hasError = true;
			}

			if (hasError || rawMolarMass.trim() === '' || rawMoles.trim() === '' || isNaN(molarMassVal) || molarMassVal <= 0 || isNaN(molesVal) || molesVal < 0) {
				lastMassResult = null;
				if (massInput) massInput.value = '—';
				if (particleCountVal) particleCountVal.textContent = '0 particles';
				setCopyButtonState(massCopyBtn, false);
				setResultTextState(massInput, false, 'text-primary');
				return;
			}

			const massResult = calculateMassWithUnits(
				molesVal,
				molesUnit,
				molarMassVal,
				molarMassUnit,
				massUnit
			);
			lastMassResult = massResult;
			if (massInput) massInput.value = format6Decimals(massResult);
			setCopyButtonState(massCopyBtn, true);
			setResultTextState(massInput, true, 'text-primary');
		}
	}

	// markerClass must be re-applied on every write: this assigns className wholesale,
	// so omitting it silently strips the .unit-pill-* hook the pill set is queried by,
	// breaking any later querySelectorAll (and any test selector) for that set.
	function updatePillStyles(buttons: NodeListOf<HTMLButtonElement>, selectedUnit: string, markerClass: string) {
		buttons.forEach(btn => {
			const unit = btn.getAttribute('data-unit');
			if (unit === selectedUnit) {
				btn.className = `${markerClass} min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-brand-green text-on-primary hover:bg-brand-green-deep cursor-pointer transition-all flex items-center justify-center`;
			} else {
				btn.className = `${markerClass} min-h-[44px] mobile:min-h-0 px-4 py-3 mobile:px-3 mobile:py-2 rounded-full text-sm font-medium bg-transparent inset-ring-1 inset-ring-hairline text-ink-muted hover:bg-surface-soft hover:text-ink cursor-pointer transition-all flex items-center justify-center`;
			}
		});
	}

	// Molar mass unit selection
	const mmButtons = document.querySelectorAll<HTMLButtonElement>('.unit-pill-mm');
	mmButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const unit = btn.getAttribute('data-unit') as MolarMassUnit;
			if (unit) {
				molarMassUnit = unit;
				updatePillStyles(mmButtons, molarMassUnit, 'unit-pill-mm');
				recalculate();
			}
		});
	});

	// Mass unit selection
	const massButtons = document.querySelectorAll<HTMLButtonElement>('.unit-pill-mass');
	massButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const unit = btn.getAttribute('data-unit') as MassUnit;
			if (unit) {
				massUnit = unit;
				updatePillStyles(massButtons, massUnit, 'unit-pill-mass');
				recalculate();
			}
		});
	});

	// Moles unit selection
	const molesButtons = document.querySelectorAll<HTMLButtonElement>('.unit-pill-moles');
	molesButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const unit = btn.getAttribute('data-unit') as MolesUnit;
			if (unit) {
				molesUnit = unit;
				updatePillStyles(molesButtons, molesUnit, 'unit-pill-moles');
				recalculate();
			}
		});
	});

	// Copy result listeners — copies the plain result number only, no unit label
	massCopyBtn?.addEventListener('click', () => {
		if (massInput && !massCopyBtn.disabled) {
			navigator.clipboard.writeText(massInput.value);
		}
	});

	molesCopyBtn?.addEventListener('click', () => {
		if (molesInput && !molesCopyBtn.disabled) {
			navigator.clipboard.writeText(molesInput.value);
		}
	});

	// Mode toggle listeners — re-parent the fields first, then apply roles/recalculate
	toggleGtoMolBtn?.addEventListener('click', () => {
		if (currentMode !== 'g_to_mol') {
			currentMode = 'g_to_mol';
			assignFieldPositions();
			updateModeUI();
		}
	});

	toggleMolToGBtn?.addEventListener('click', () => {
		if (currentMode !== 'mol_to_g') {
			currentMode = 'mol_to_g';
			assignFieldPositions();
			updateModeUI();
		}
	});

	// Input listeners
	molarMassInput?.addEventListener('input', () => {
		recalculate();
		updateStepperState(molarMassInput, molarMassStepDown, molarMassStepUp, molarMassStepperDivider);
	});
	massInput?.addEventListener('input', () => {
		recalculate();
		updateStepperState(massInput, massStepDown, massStepUp, massStepperDivider);
	});
	molesInput?.addEventListener('input', () => {
		recalculate();
		updateStepperState(molesInput, molesStepDown, molesStepUp, molesStepperDivider);
	});

	// Stepper button listeners
	molarMassStepUp?.addEventListener('click', () => stepInput(molarMassInput, 'up'));
	molarMassStepDown?.addEventListener('click', () => stepInput(molarMassInput, 'down'));
	massStepUp?.addEventListener('click', () => stepInput(massInput, 'up'));
	massStepDown?.addEventListener('click', () => stepInput(massInput, 'down'));
	molesStepUp?.addEventListener('click', () => stepInput(molesInput, 'up'));
	molesStepDown?.addEventListener('click', () => stepInput(molesInput, 'down'));

	// Initial render setup
	updateModeUI();
	updateStepperState(molarMassInput, molarMassStepDown, molarMassStepUp, molarMassStepperDivider);
	updateStepperState(massInput, massStepDown, massStepUp, massStepperDivider);
	updateStepperState(molesInput, molesStepDown, molesStepUp, molesStepperDivider);
</script>

<script>
	import { SEED_ELEMENTS, buildFormula, computeCustomMolarMass, PRESETS, PRESET_GROUP_ORDER } from '../utils/browseElements';

	// --- DOM refs ---
	const molarMassInput = document.getElementById('molar-mass') as HTMLInputElement | null;
	const browseTrigger = document.getElementById('browse-trigger');
	const browseChevron = document.getElementById('browse-chevron');
	const browsePanel = document.getElementById('browse-panel');

	const tabPresets = document.getElementById('tab-presets');
	const tabCustom = document.getElementById('tab-custom');
	const panelPresets = document.getElementById('panel-presets');
	const panelCustom = document.getElementById('panel-custom');

	const presetTrigger = document.getElementById('preset-trigger');
	const presetTriggerLabel = document.getElementById('preset-trigger-label');
	const presetListbox = document.getElementById('preset-listbox');

	const elementSearch = document.getElementById('element-search') as HTMLInputElement | null;
	const elementGrid = document.getElementById('element-grid');
	const elementGridScroll = document.getElementById('element-grid-scroll');
	const elementGridEmpty = document.getElementById('element-grid-empty');
	const customFormula = document.getElementById('custom-formula');
	const customMolarMassVal = document.getElementById('custom-molar-mass-val');
	const useCustomBtn = document.getElementById('use-custom');

	// --- State ---
	let panelOpen = false;
	let activeTab: 'presets' | 'custom' = 'custom';

	// --- Panel toggle ---
	browseTrigger?.addEventListener('click', () => {
		panelOpen = !panelOpen;
		browsePanel?.classList.toggle('hidden', !panelOpen);
		browseChevron?.classList.toggle('rotate-90', panelOpen);
		if (panelOpen) {
			if (activeTab === 'custom') customGrid.render();
			// Scroll so the newly-revealed panel is visible, instead of leaving
			// the user to discover it extends below the fold on their own. Only
			// on the open action — not on close, tab switches, or search
			// filtering, none of which call this handler. rAF lets the browser
			// commit the unhidden panel's layout (and, on the custom tab, the
			// grid renderGrid() just populated) before measuring where to
			// scroll to, same ordering moveFieldTo() uses elsewhere for a
			// post-DOM-change follow-up.
			//
			// Below the 520px breakpoint this uses a 'nearest'-style scroll
			// instead of desktop's full 'start' alignment — see DESIGN.md for
			// why — but computed manually rather than via scrollIntoView's own
			// 'nearest' so a reserve can be folded in for the Build-custom
			// tab's "Use this molar mass" button. That button is still
			// `hidden` at scroll time (nothing is selected yet), so it
			// contributes zero height to the panel this measures against;
			// native 'nearest' would happily zero out the gap below the
			// panel, and the button — appearing later, after a selection,
			// with no scroll of its own — would render partly or fully below
			// the fold. The reserve is measured live (toggle the button's
			// `hidden` class off, diff the panel height, toggle back) rather
			// than hardcoded, so it can't go stale if the button's own size
			// ever changes. The Presets tab has no equivalent button —
			// selecting a compound there fills Molar Mass and collapses the
			// whole panel immediately, so there's nothing that can land below
			// the fold after the fact — so `btn` is only ever looked up for
			// 'custom'.
			requestAnimationFrame(() => {
				const mobile = !window.matchMedia('(min-width: 520px)').matches;
				if (!mobile) {
					browsePanel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
					return;
				}
				if (!browsePanel) return;
				const btn = activeTab === 'custom' ? useCustomBtn : null;
				let reserve = 0;
				if (btn?.classList.contains('hidden')) {
					const heightBefore = browsePanel.getBoundingClientRect().height;
					btn.classList.remove('hidden');
					reserve = browsePanel.getBoundingClientRect().height - heightBefore;
					btn.classList.add('hidden');
				}
				const rect = browsePanel.getBoundingClientRect();
				const startTarget = window.scrollY + rect.top;
				const nearestTarget = window.scrollY + rect.bottom - window.innerHeight;
				// Never scroll further than 'start' would — that full-alignment
				// jump is exactly the "too much scroll" behavior 'nearest'
				// replaced, so the reserve is capped rather than allowed to push
				// past it on a panel too tall for reserve + content to both fit.
				const target = Math.min(startTarget, nearestTarget + reserve);
				window.scrollTo({ top: target, behavior: 'smooth' });
			});
		}
	});

	function collapsePanel() {
		panelOpen = false;
		browsePanel?.classList.add('hidden');
		browseChevron?.classList.remove('rotate-90');
		closePresetListbox();
	}

	// --- Tab switching ---
	function setTab(tab: 'presets' | 'custom') {
		activeTab = tab;
		const presetActive = tab === 'presets';
		panelPresets?.classList.toggle('hidden', !presetActive);
		panelCustom?.classList.toggle('hidden', presetActive);
		closePresetListbox();

		const activeClass = 'py-2 px-4 text-sm font-medium text-brand-green border-b-2 border-brand-green -mb-px transition-colors cursor-pointer';
		const inactiveClass = 'py-2 px-4 text-sm font-medium text-stone border-b-2 border-transparent -mb-px hover:text-ink transition-colors cursor-pointer';
		if (tabPresets) tabPresets.className = presetActive ? activeClass : inactiveClass;
		if (tabCustom) tabCustom.className = presetActive ? inactiveClass : activeClass;

		if (tab === 'custom') customGrid.render();
	}

	tabPresets?.addEventListener('click', () => setTab('presets'));
	tabCustom?.addEventListener('click', () => setTab('custom'));

	// --- Molar Mass mode dropdown ---
	//
	// Stage 1 of a multi-stage rebuild (see the markup comment above
	// #molar-mass-mode-wrapper): a mode selector fused to the left of the
	// Molar Mass input, replacing the implicit "always typed in" assumption
	// with three modes. This stage wires only the dropdown shell and
	// mode-switching state — selecting "Build custom"/"Compounds" does not
	// yet swap in their panels (stages 3-4), and the "Browse elements"
	// accordion above is untouched until stage 5's teardown.
	//
	// Follows the same ARIA APG "Collapsible Dropdown Listbox" pattern as
	// #preset-listbox below (focus stays on #molar-mass-mode-trigger the
	// whole time the popup is open; aria-activedescendant tracks the
	// highlighted option instead of DOM focus moving into the listbox), and
	// reuses its `position: fixed`-off-trigger-rect + scroll/resize
	// reposition handling verbatim — see that section's comments for why.
	type MolarMassMode = 'type-in' | 'build-custom' | 'compounds';
	const MOLAR_MASS_MODES: { mode: MolarMassMode; label: string }[] = [
		{ mode: 'type-in', label: 'Type in' },
		{ mode: 'build-custom', label: 'Build custom' },
		{ mode: 'compounds', label: 'Compounds' },
	];

	const molarMassModeTrigger = document.getElementById('molar-mass-mode-trigger');
	const molarMassModeLabel = document.getElementById('molar-mass-mode-label');
	const molarMassModeListbox = document.getElementById('molar-mass-mode-listbox');
	// The whole stepper ("+"/"-" capsule) — hidden outside Type in mode, see
	// selectMolarMassMode below.
	const molarMassStepperEl = document.getElementById('molar-mass-stepper');

	let activeMolarMassMode: MolarMassMode = 'type-in';
	let molarMassModeOpen = false;
	let molarMassModeActiveIndex = -1;

	// --- Per-mode state store (stage 2) ---
	//
	// Each mode owns an independent slot. Switching modes NEVER clears another
	// mode's slot — it only changes which slot #molar-mass is currently a view
	// of. A mode never touched since load reads as its empty shape below.
	//
	// PANELS PLUG IN HERE. The Build-custom panel (stage 3, wired below) writes
	// its result with setModeValue() and reads back what to re-select via
	// getModeValue(); the Compounds panel (stage 4) should do the same. Neither
	// should touch #molar-mass.value directly — setModeValue() already refreshes
	// the input when the mode it wrote to is the active one, so writing the input
	// as well would double-apply and desync the store from the DOM.
	//
	// Shape notes, chosen so stages 3-4 don't need another rework:
	//   • build-custom.quantities is the REAL source of truth for that mode —
	//     `formula`/`molarMass` are both derived from it (buildFormula() /
	//     computeCustomMolarMass() in browseElements.ts). Stage 3 needs the
	//     quantities to restore the element grid's selection + per-tile counts
	//     on reopen; deriving them back out of a formula STRING would mean
	//     parsing subscripts, so the map is stored directly. Held as a plain
	//     Record, not a Map, so the whole store stays structured-clone- and
	//     JSON-safe (Playwright reads it across the page boundary, and a Map
	//     would arrive as `{}`). Stage 3 converts with
	//     `new Map(Object.entries(quantities ?? {}))`.
	//   • compounds keeps `name` AND `formula`, not just a name: the existing
	//     picker's trigger label is `${name} (${formula})` (see
	//     the accordion picker's onSelect below), so stage 4 needs both to render its
	//     trigger without re-looking-up PRESETS. `name` is unique across
	//     PRESETS, so it doubles as the identity stage 4 re-highlights by —
	//     deliberately not a list index, which would silently repoint if the
	//     PRESETS order ever changes. Field is `name` (not `compoundName`) so
	//     a Preset's own fields can be copied across without renaming.
	//   • molarMass is a number, already rounded to its display precision by
	//     whoever writes it — the formatting policy stays at the write site,
	//     as it already does for #use-custom's `toFixed(3)`. Stage 3 should
	//     therefore store `Number(mass.toFixed(3))`, not the raw float.
	//   • type-in holds the RAW STRING, not a number: it must round-trip
	//     exactly what was typed, including in-progress text like "18." or
	//     "" — coercing to a number would rewrite the field under the user.
	type TypeInState = { raw: string };
	type BuildCustomState = {
		quantities: Record<string, number> | null;
		formula: string | null;
		molarMass: number | null;
	};
	type CompoundsState = {
		name: string | null;
		formula: string | null;
		molarMass: number | null;
	};
	type MolarMassModeStates = {
		'type-in': TypeInState;
		'build-custom': BuildCustomState;
		'compounds': CompoundsState;
	};

	const molarMassModeStates: MolarMassModeStates = {
		'type-in': { raw: '' },
		'build-custom': { quantities: null, formula: null, molarMass: null },
		'compounds': { name: null, formula: null, molarMass: null },
	};

	/** What #molar-mass should display while `mode` is active. '' shows the placeholder. */
	function molarMassDisplayValue(mode: MolarMassMode): string {
		if (mode === 'type-in') return molarMassModeStates['type-in'].raw;
		const mass = molarMassModeStates[mode].molarMass;
		return mass === null ? '' : String(mass);
	}

	// Re-points #molar-mass at the active mode's slot. Called synchronously
	// from the mode-switch handler (and from setModeValue), so the field never
	// paints an intermediate frame still showing the outgoing mode's value.
	//
	// readOnly, NOT disabled: a disabled input drops out of the tab order and
	// is skipped by some screen readers, and the value here is real content a
	// non-typing user still needs to read. readOnly keeps it focusable, in the
	// accessibility tree, and still labelled by its <label for="molar-mass">.
	// (stepInput() already bails on a readOnly input, so the stepper — itself
	// hidden outside Type in — can't write through this either.)
	function syncMolarMassInputToMode({ dispatch = true } = {}) {
		if (!molarMassInput) return;
		molarMassInput.readOnly = activeMolarMassMode !== 'type-in';
		molarMassInput.value = molarMassDisplayValue(activeMolarMassMode);
		// Let the calculator recompute against the newly-shown molar mass —
		// same "write the field, then announce it" contract #use-custom and
		// the preset picker's onSelect already use to reach the recalc in the first
		// <script> block (separate module scope, no shared function to call).
		if (dispatch) molarMassInput.dispatchEvent(new Event('input', { bubbles: true }));
	}

	/**
	 * Read a mode's stored slot. Returns the live object — treat it as
	 * read-only and go through setModeValue() to write.
	 */
	function getModeValue<M extends MolarMassMode>(mode: M): MolarMassModeStates[M] {
		return molarMassModeStates[mode];
	}

	/**
	 * Replace a mode's stored slot. If that mode is currently active, the
	 * input is refreshed (and a recalc announced) in the same tick.
	 * Writing to an INACTIVE mode is legal and silent — that's what makes a
	 * panel able to stage a value the user hasn't switched to yet.
	 */
	function setModeValue<M extends MolarMassMode>(mode: M, data: MolarMassModeStates[M]): void {
		molarMassModeStates[mode] = data;
		if (mode === activeMolarMassMode) syncMolarMassInputToMode();
		// The store is the single source of truth for the mode panels, so every
		// write to a slot — whoever made it — is reflected back into that mode's
		// panel. See onBuildCustomStateChanged()/onCompoundsStateChanged() for
		// the one case each skips.
		if (mode === 'build-custom') onBuildCustomStateChanged();
		if (mode === 'compounds') onCompoundsStateChanged();
	}

	// --- Build custom panel plumbing (stage 3) ---
	// Declared here, next to the state it mirrors; assigned at the bottom of this
	// script, where createElementGrid() and its column constants are in scope.
	// Everything below runs from user interaction only, well after that point.
	const molarMassModeWrapper = document.getElementById('molar-mass-mode-wrapper');
	const molarMassBuildPanel = document.getElementById('molar-mass-build-panel');
	const molarMassCustomFormula = document.getElementById('molar-mass-custom-formula');
	const molarMassCustomMass = document.getElementById('molar-mass-custom-mass');
	const molarMassCompoundsPanel = document.getElementById('molar-mass-compounds-panel');
	let buildCustomGrid: ElementGridInstance | null = null;
	let buildCustomPanelWriting = false;
	let compoundsPicker: PresetListboxInstance | null = null;
	let compoundsPanelWriting = false;

	// Which overlay belongs to which mode. Type in has none — it is the bare
	// field — so it simply matches nothing here and every panel hides.
	const MOLAR_MASS_MODE_PANELS: { mode: MolarMassMode; el: HTMLElement | null }[] = [
		{ mode: 'build-custom', el: molarMassBuildPanel },
		{ mode: 'compounds', el: molarMassCompoundsPanel },
	];

	/** Repaint the Build-custom panel from its slot. */
	function onBuildCustomStateChanged() {
		const state = molarMassModeStates['build-custom'];
		if (molarMassCustomFormula) molarMassCustomFormula.textContent = state.formula || '—';
		if (molarMassCustomMass) {
			// toFixed(3) again on an already-rounded number is a no-op numerically
			// but not textually — it restores the trailing zeros the slot's Number
			// dropped (20.18 → "20.180"), matching the accordion bar's own format.
			molarMassCustomMass.textContent = state.molarMass === null ? '—' : `${state.molarMass.toFixed(3)} g/mol`;
		}
		// Skipped for the panel's own writes: the tiles already show this
		// selection, so rebuilding the grid would be churn on every +/- click.
		if (buildCustomPanelWriting || !buildCustomGrid) return;
		buildCustomGrid.setQuantities(new Map(Object.entries(state.quantities ?? {})));
	}

	/** Repaint the Compounds panel from its slot. */
	function onCompoundsStateChanged() {
		// Skipped for the panel's own writes: commit() has already painted the
		// row the user just clicked, and re-selecting it would only re-run the
		// scroll-into-view underneath their pointer.
		if (compoundsPanelWriting || !compoundsPicker) return;
		compoundsPicker.selectByName(molarMassModeStates['compounds'].name);
	}

	// A mode panel spans the card's content box: flush left with the Molar Mass
	// control, flush right with the Mass field. Both edges come from ONE measured
	// number — the control's own inset from the card, which is the card's outer
	// padding (24px at `mobile:`, 16px below) — mirrored to the right. Reading it
	// rather than hardcoding keeps this correct at both breakpoints, and avoids
	// picking up the 12px midline padding, which is a different value on the same
	// element (see .field-half:first-child in the <style> block).
	//
	// Shared by every mode panel: they all occupy the same slot under the field,
	// so there is one geometry, not one per panel.
	function positionMolarMassModePanel(panel: HTMLElement) {
		if (!molarMassModeWrapper) return;
		const row = molarMassModeWrapper.closest('.field-row');
		if (!row) return;
		const rowRect = row.getBoundingClientRect();
		const wrapRect = molarMassModeWrapper.getBoundingClientRect();
		const outerPad = wrapRect.left - rowRect.left;
		// Flush with the control's bottom edge, not offset off it like the two
		// listboxes: this reads as an extension of the field rather than a popup
		// floating over it.
		panel.style.top = `${wrapRect.bottom}px`;
		panel.style.left = `${wrapRect.left}px`;
		panel.style.width = `${rowRect.width - outerPad * 2}px`;
	}

	function activeMolarMassModePanel(): HTMLElement | null {
		return MOLAR_MASS_MODE_PANELS.find(p => p.mode === activeMolarMassMode)?.el ?? null;
	}

	// Same reposition-don't-close handling the two listboxes use: a panel is
	// anchored to an element that moves with the page, and unlike them it stays
	// open for as long as its mode is selected, so it has to track scrolling
	// rather than dismiss on it. Capture phase to catch scrolls in any container.
	function handleMolarMassModePanelViewportChange() {
		const panel = activeMolarMassModePanel();
		if (panel) positionMolarMassModePanel(panel);
	}

	/** Show/hide the mode panels for the active mode, restoring their contents. */
	function syncMolarMassModePanels() {
		for (const { mode, el } of MOLAR_MASS_MODE_PANELS) {
			el?.classList.toggle('hidden', mode !== activeMolarMassMode);
		}
		const panel = activeMolarMassModePanel();
		if (!panel) {
			window.removeEventListener('scroll', handleMolarMassModePanelViewportChange, true);
			window.removeEventListener('resize', handleMolarMassModePanelViewportChange);
			return;
		}
		// Ordered: unhidden (above) → placed → refilled. Both panels measure zero
		// width until they are visible AND sized, so anything that depends on
		// their box — the grid's column solve, an option's scroll-into-view —
		// has to come after the placement.
		positionMolarMassModePanel(panel);
		if (activeMolarMassMode === 'build-custom') {
			// Reload from the slot rather than trusting whatever the grid was left
			// holding — that is what makes leaving and returning to this mode
			// restore the exact prior selection.
			onBuildCustomStateChanged();
			buildCustomGrid?.layout();
		} else {
			onCompoundsStateChanged();
			// Highlight follows the restored selection, falling back to the first
			// option when the slot is empty — same rule openPresetListbox() uses.
			const selected = compoundsPicker?.getSelectedIndex() ?? -1;
			compoundsPicker?.setActive(selected >= 0 ? selected : 0);
		}
		window.addEventListener('scroll', handleMolarMassModePanelViewportChange, true);
		window.addEventListener('resize', handleMolarMassModePanelViewportChange);
	}

	type MolarMassModeOption = { mode: MolarMassMode; label: string; el: HTMLElement };
	const molarMassModeOptions: MolarMassModeOption[] = [];

	function buildMolarMassModeListbox() {
		if (!molarMassModeListbox) return;
		MOLAR_MASS_MODES.forEach(({ mode, label }, i) => {
			const el = document.createElement('div');
			el.id = `molar-mass-mode-option-${i}`;
			el.setAttribute('role', 'option');
			el.className = 'px-3 py-2 text-sm font-sans cursor-pointer whitespace-nowrap';
			el.textContent = label;
			molarMassModeListbox.appendChild(el);
			molarMassModeOptions.push({ mode, label, el });
		});
	}
	buildMolarMassModeListbox();

	function updateMolarMassModeOptionStates() {
		molarMassModeOptions.forEach(({ el, mode }, idx) => {
			const isActive = idx === molarMassModeActiveIndex;
			const isSelected = mode === activeMolarMassMode;
			el.setAttribute('aria-selected', String(isSelected));
			el.classList.toggle('bg-surface-2', isActive);
			el.classList.toggle('text-primary', isSelected);
			el.classList.toggle('font-medium', isSelected);
			el.classList.toggle('text-ink', !isSelected);
		});
		if (molarMassModeActiveIndex >= 0) {
			molarMassModeTrigger?.setAttribute('aria-activedescendant', molarMassModeOptions[molarMassModeActiveIndex].el.id);
		} else {
			molarMassModeTrigger?.removeAttribute('aria-activedescendant');
		}
	}
	updateMolarMassModeOptionStates();

	function setMolarMassModeActive(index: number) {
		if (molarMassModeOptions.length === 0) return;
		molarMassModeActiveIndex = Math.max(0, Math.min(index, molarMassModeOptions.length - 1));
		updateMolarMassModeOptionStates();
		molarMassModeOptions[molarMassModeActiveIndex].el.scrollIntoView({ block: 'nearest' });
	}

	function positionMolarMassModeListbox() {
		if (!molarMassModeTrigger || !molarMassModeListbox) return;
		const rect = molarMassModeTrigger.getBoundingClientRect();
		molarMassModeListbox.style.top = `${rect.bottom + 4}px`;
		molarMassModeListbox.style.left = `${rect.left}px`;
		molarMassModeListbox.style.minWidth = `${rect.width}px`;
	}

	function handleMolarMassModeViewportChange() {
		if (!molarMassModeOpen) return;
		positionMolarMassModeListbox();
	}

	function openMolarMassModeListbox() {
		if (molarMassModeOpen || !molarMassModeListbox || molarMassModeOptions.length === 0) return;
		molarMassModeOpen = true;
		positionMolarMassModeListbox();
		molarMassModeListbox.classList.remove('hidden');
		molarMassModeTrigger?.setAttribute('aria-expanded', 'true');
		const selectedIdx = molarMassModeOptions.findIndex(o => o.mode === activeMolarMassMode);
		setMolarMassModeActive(selectedIdx >= 0 ? selectedIdx : 0);
		document.addEventListener('click', handleMolarMassModeOutsideClick, true);
		window.addEventListener('scroll', handleMolarMassModeViewportChange, true);
		window.addEventListener('resize', handleMolarMassModeViewportChange);
	}

	function closeMolarMassModeListbox() {
		if (!molarMassModeOpen) return;
		molarMassModeOpen = false;
		molarMassModeListbox?.classList.add('hidden');
		molarMassModeTrigger?.setAttribute('aria-expanded', 'false');
		molarMassModeActiveIndex = -1;
		molarMassModeTrigger?.removeAttribute('aria-activedescendant');
		document.removeEventListener('click', handleMolarMassModeOutsideClick, true);
		window.removeEventListener('scroll', handleMolarMassModeViewportChange, true);
		window.removeEventListener('resize', handleMolarMassModeViewportChange);
	}

	function handleMolarMassModeOutsideClick(e: MouseEvent) {
		const target = e.target as Node;
		if (molarMassModeTrigger?.contains(target) || molarMassModeListbox?.contains(target)) return;
		closeMolarMassModeListbox();
	}

	function selectMolarMassMode(index: number) {
		const opt = molarMassModeOptions[index];
		if (!opt) return;
		activeMolarMassMode = opt.mode;
		if (molarMassModeLabel) molarMassModeLabel.textContent = opt.label;
		// The stepper ("+") only makes sense while typing a value directly —
		// hidden for Build custom/Compounds, whose panels (stages 3-4) will
		// fill Molar Mass themselves.
		molarMassStepperEl?.classList.toggle('hidden', opt.mode !== 'type-in');
		// Re-point the input at the incoming mode's slot. Ordered AFTER
		// activeMolarMassMode is reassigned, which is what keeps the typing
		// listener below from writing the restored value into the outgoing
		// mode's slot.
		syncMolarMassInputToMode();
		syncMolarMassModePanels();
		updateMolarMassModeOptionStates();
		closeMolarMassModeListbox();
	}

	/** Programmatic mode switch — same effect as picking the option by hand. */
	function setActiveMolarMassMode(mode: MolarMassMode) {
		const idx = molarMassModeOptions.findIndex(o => o.mode === mode);
		if (idx >= 0) selectMolarMassMode(idx);
	}

	molarMassModeTrigger?.addEventListener('click', () => {
		if (molarMassModeOpen) closeMolarMassModeListbox();
		else openMolarMassModeListbox();
	});

	molarMassModeTrigger?.addEventListener('keydown', (e) => {
		switch (e.key) {
			case 'ArrowDown':
				e.preventDefault();
				if (!molarMassModeOpen) openMolarMassModeListbox();
				else setMolarMassModeActive(molarMassModeActiveIndex + 1);
				break;
			case 'ArrowUp':
				e.preventDefault();
				if (!molarMassModeOpen) openMolarMassModeListbox();
				else setMolarMassModeActive(molarMassModeActiveIndex - 1);
				break;
			case 'Home':
				if (molarMassModeOpen) { e.preventDefault(); setMolarMassModeActive(0); }
				break;
			case 'End':
				if (molarMassModeOpen) { e.preventDefault(); setMolarMassModeActive(molarMassModeOptions.length - 1); }
				break;
			case 'Enter':
			case ' ':
				e.preventDefault();
				if (!molarMassModeOpen) { openMolarMassModeListbox(); break; }
				if (molarMassModeActiveIndex >= 0) selectMolarMassMode(molarMassModeActiveIndex);
				break;
			case 'Escape':
				if (molarMassModeOpen) { e.preventDefault(); closeMolarMassModeListbox(); }
				break;
			case 'Tab':
				closeMolarMassModeListbox();
				break;
		}
	});

	molarMassModeListbox?.addEventListener('click', (e) => {
		const optionEl = (e.target as HTMLElement).closest('[role="option"]');
		if (!optionEl) return;
		const idx = molarMassModeOptions.findIndex(({ el }) => el === optionEl);
		if (idx >= 0) selectMolarMassMode(idx);
	});

	// Mouse hover shares the same "active" highlight as keyboard nav — see the
	// identical rationale on #preset-listbox's own mouseover handler below.
	molarMassModeListbox?.addEventListener('mouseover', (e) => {
		const optionEl = (e.target as HTMLElement).closest('[role="option"]');
		if (!optionEl) return;
		const idx = molarMassModeOptions.findIndex(({ el }) => el === optionEl);
		if (idx >= 0 && idx !== molarMassModeActiveIndex) setMolarMassModeActive(idx);
	});

	// Typing (and the stepper's programmatic writes) feeds the Type-in slot,
	// and ONLY that slot. A second, independent 'input' listener on the same
	// element — the first <script> block has its own for recalc/stepper state,
	// which stays untouched.
	//
	// The mode guard is what makes syncMolarMassInputToMode() safe to call on
	// every switch: its dispatch re-enters here, and while switching TO a
	// non-Type-in mode this returns early, so the outgoing mode's typed text
	// is never overwritten by the incoming mode's value. Switching back TO
	// Type in re-enters with the restored raw string and writes it over
	// itself, which is a no-op.
	//
	// Known transitional gap, resolved by stage 5: the old "Browse elements"
	// accordion still writes #molar-mass directly (#use-custom and
	// the accordion preset picker's onSelect). While Type in is active that lands here and is
	// captured correctly. While Build custom/Compounds is active it is
	// skipped, so the field can show a value the active slot doesn't hold
	// until the next mode switch restores the slot. Not reconciled on
	// purpose: that UI is deleted in stage 5, and coupling the two now would
	// be work thrown away.
	molarMassInput?.addEventListener('input', () => {
		if (activeMolarMassMode !== 'type-in') return;
		molarMassModeStates['type-in'] = { raw: molarMassInput.value };
	});

	// Integration surface for stages 3-4 and for the Playwright suite, which
	// has to drive this state directly while the Build-custom and Compounds
	// panels that will eventually write it don't exist yet. Kept as an
	// explicit named hook rather than reaching into the module's closure, so
	// there is exactly one documented way in. `as any` because typing a
	// one-off window property would mean shipping a global .d.ts for a hook
	// only this module and its tests use.
	(window as any).molarMassMode = {
		get: getModeValue,
		set: setModeValue,
		getActiveMode: () => activeMolarMassMode,
		setActiveMode: setActiveMolarMassMode,
	};

	// Put the DOM in sync with the initial mode without announcing a recalc:
	// on load the field is already empty and the first <script> block has done
	// its own init pass, so a dispatch here would only re-run that work.
	syncMolarMassInputToMode({ dispatch: false });

	// --- Presets: custom listbox (reusable) ---
	//
	// Replaces the native <select> (see the markup comment above
	// #preset-listbox). Reads PRESETS/PRESET_GROUP_ORDER from browseElements.ts
	// rather than hardcoding a second copy of the compound list.
	//
	// Stage 4 of the Molar Mass mode rebuild needs a second compound picker —
	// one in the accordion's Presets tab, one under the Molar Mass field — so
	// what both need is factored out here, the same way createElementGrid()
	// factored out the element grid in stage 3. The split is by what actually
	// differs, which is the LIFECYCLE, not the list:
	//
	//   Shared (here): building the grouped options, active/selected paint,
	//   aria-activedescendant, scroll-into-view, typeahead matching, and the
	//   click/hover delegation.
	//
	//   Per-owner (left to each call site): whether the list opens and closes
	//   at all, where it is positioned, and what a selection does downstream.
	//   The accordion's instance is the popup half of a combobox — ARIA APG
	//   "Collapsible Dropdown Listbox", focus staying on #preset-trigger, which
	//   is also what carries aria-activedescendant. The Molar Mass panel's is a
	//   plain always-open APG "Listbox" that is focusable itself. Neither
	//   lifecycle is expressible as options on the other, so this exposes index
	//   math and paint and lets each owner drive it.
	//
	// idPrefix exists because option ids are referenced by
	// aria-activedescendant: a second instance emitting `preset-option-0` again
	// would put duplicate ids in the document and leave that reference
	// ambiguous — the same class of collision as stage 3's `.element-grid-scroll`
	// double-match, caught here before it shipped rather than after.
	type PresetOption = { preset: (typeof PRESETS)[number]; el: HTMLElement };

	type PresetListboxInstance = {
		options: PresetOption[];
		getActiveIndex: () => number;
		getSelectedIndex: () => number;
		/** Highlight an option (clamped) and scroll it into view. */
		setActive: (index: number) => void;
		/** Drop the highlight — for an owner that collapses its list. */
		clearActive: () => void;
		/** Commit a selection: repaint, then hand the preset to onSelect. */
		commit: (index: number) => void;
		/**
		 * Restore a selection by compound name WITHOUT firing onSelect — the
		 * repaint-from-stored-state path. Returns the matched index, or -1
		 * (which also clears the selection).
		 */
		selectByName: (name: string | null) => number;
		/** Advance the typeahead buffer from `from`; returns a match index, or -1. */
		typeahead: (char: string, from: number) => number;
	};

	function createPresetListbox(opts: {
		listboxEl: HTMLElement | null;
		/** Namespaces this instance's option ids. See the note above. */
		idPrefix: string;
		/**
		 * Element carrying aria-activedescendant: the combobox trigger when the
		 * list is a popup, the listbox itself when it is always-on and focusable.
		 */
		activeDescendantHost: HTMLElement | null;
		onSelect: (preset: (typeof PRESETS)[number], index: number) => void;
	}): PresetListboxInstance {
		const { listboxEl, idPrefix, activeDescendantHost, onSelect } = opts;
		const options: PresetOption[] = [];
		let activeIndex = -1; // keyboard/hover-highlighted option
		let selectedIndex = -1; // committed selection
		let typeaheadBuffer = '';
		let typeaheadTimer: number | undefined;

		if (listboxEl) {
			let i = 0;
			for (const groupName of PRESET_GROUP_ORDER) {
				const groupPresets = PRESETS.filter(p => p.group === groupName);
				if (groupPresets.length === 0) continue;

				const group = document.createElement('div');
				group.setAttribute('role', 'group');
				group.setAttribute('aria-label', groupName);

				// Decorative heading only — the group's accessible name already
				// comes from aria-label above, so this is hidden from AT to
				// avoid announcing it twice.
				const heading = document.createElement('div');
				heading.textContent = groupName;
				heading.setAttribute('aria-hidden', 'true');
				heading.className = 'px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-[0.4px] text-ink-subtle';
				group.appendChild(heading);

				for (const preset of groupPresets) {
					const el = document.createElement('div');
					el.id = `${idPrefix}-option-${i}`;
					el.setAttribute('role', 'option');
					el.setAttribute('aria-selected', 'false');
					el.className = 'px-3 py-2 text-sm font-sans text-ink cursor-pointer';
					el.textContent = `${preset.name} (${preset.formula}) — ${preset.molarMass} g/mol`;
					group.appendChild(el);
					options.push({ preset, el });
					i++;
				}
				listboxEl.appendChild(group);
			}
		}

		function updateOptionStates() {
			options.forEach(({ el }, idx) => {
				const isActive = idx === activeIndex;
				const isSelected = idx === selectedIndex;
				el.setAttribute('aria-selected', String(isSelected));
				el.classList.toggle('bg-surface-2', isActive && !isSelected);
				el.classList.toggle('bg-primary-soft', isSelected);
				el.classList.toggle('text-primary-pressed', isSelected);
			});
			if (activeIndex >= 0) {
				activeDescendantHost?.setAttribute('aria-activedescendant', options[activeIndex].el.id);
			} else {
				activeDescendantHost?.removeAttribute('aria-activedescendant');
			}
		}

		function setActive(index: number) {
			if (options.length === 0) return;
			activeIndex = Math.max(0, Math.min(index, options.length - 1));
			updateOptionStates();
			options[activeIndex].el.scrollIntoView({ block: 'nearest' });
		}

		function commit(index: number) {
			const opt = options[index];
			if (!opt) return;
			selectedIndex = index;
			updateOptionStates();
			onSelect(opt.preset, index);
		}

		listboxEl?.addEventListener('click', (e) => {
			const optionEl = (e.target as HTMLElement).closest('[role="option"]');
			if (!optionEl) return;
			const idx = options.findIndex(({ el }) => el === optionEl);
			if (idx >= 0) commit(idx);
		});

		// Mouse hover shares the same "active" highlight as keyboard nav — this
		// was documented (DESIGN.md: "highlighted (keyboard-active or hovered)
		// gets bg-surface-2") but never actually wired up: option elements were
		// built with no `hover:` class and no pointer/mouse listener of any
		// kind, so a mouse-only user got no feedback moving over the list.
		// `mouseover` (delegated, bubbles), not `mouseenter` (doesn't bubble —
		// wouldn't reach a listener on the shared container), reusing
		// setActive() so hovering an option updates aria-activedescendant
		// the same way arrowing to it does, keeping mouse and keyboard state in
		// sync rather than layering on a second, independent visual-only state.
		listboxEl?.addEventListener('mouseover', (e) => {
			const optionEl = (e.target as HTMLElement).closest('[role="option"]');
			if (!optionEl) return;
			const idx = options.findIndex(({ el }) => el === optionEl);
			if (idx >= 0 && idx !== activeIndex) setActive(idx);
		});

		return {
			options,
			getActiveIndex: () => activeIndex,
			getSelectedIndex: () => selectedIndex,
			setActive,
			clearActive() {
				activeIndex = -1;
				updateOptionStates();
			},
			commit,
			selectByName(name) {
				const idx = name === null ? -1 : options.findIndex(o => o.preset.name === name);
				selectedIndex = idx;
				updateOptionStates();
				return idx;
			},
			typeahead(char, from) {
				if (options.length === 0) return -1;
				window.clearTimeout(typeaheadTimer);
				typeaheadBuffer += char.toLowerCase();
				typeaheadTimer = window.setTimeout(() => { typeaheadBuffer = ''; }, 500);
				const n = options.length;
				for (let step = 1; step <= n; step++) {
					const idx = (from + step + n) % n;
					if (options[idx].preset.name.toLowerCase().startsWith(typeaheadBuffer)) return idx;
				}
				return -1;
			},
		};
	}

	// The accordion's Presets tab: the popup half of a combobox. #preset-trigger
	// keeps focus and carries aria-activedescendant; the open/close/position
	// lifecycle below is this instance's alone.
	const presetPicker = createPresetListbox({
		listboxEl: presetListbox,
		idPrefix: 'preset',
		activeDescendantHost: presetTrigger,
		onSelect: (preset) => {
			if (!molarMassInput) return;
			// Trigger label shows the compound, not the full option row text
			// (which also carries " — <mass> g/mol") — the mass is already
			// visible in the Molar Mass field itself once filled below, so
			// repeating it on the trigger would be redundant. This persists
			// after the panel collapses (see below) rather than reverting to
			// the placeholder, so the trigger keeps showing what's actually
			// loaded into Molar Mass. aria-labelledby="preset-label
			// preset-trigger-label" means the trigger's accessible name is
			// computed live from this element's text content, so updating it
			// here keeps the accessible name in sync automatically — no
			// separate aria-label to maintain.
			if (presetTriggerLabel) {
				presetTriggerLabel.textContent = `${preset.name} (${preset.formula})`;
				presetTriggerLabel.classList.remove('text-ink-tertiary');
			}
			molarMassInput.value = String(preset.molarMass);
			molarMassInput.dispatchEvent(new Event('input'));
			// Fill Molar Mass, then collapse the whole Browse Elements panel —
			// same end effect the old select-then-"Use this molar mass" flow
			// had. Unlike that old flow, the picker's selection is NOT reset:
			// reopening the panel/listbox shows the last-picked compound both
			// on the trigger and as the pre-highlighted option (see
			// openPresetListbox's use of getSelectedIndex), rather than
			// starting over from the placeholder every time.
			collapsePanel();
		},
	});

	let presetOpen = false;

	// #preset-listbox is `position: fixed`, positioned off #preset-trigger's
	// own bounding rect (getBoundingClientRect() is already viewport-relative,
	// same coordinate space `fixed` uses — no scrollX/scrollY offset needed,
	// unlike positioning an `absolute` element against document coordinates).
	// Computed fresh on every open rather than left to CSS, since fixed has no
	// positioned-ancestor offset to lean on. See the markup comment above
	// #preset-listbox for why this can't be plain `absolute` inside a
	// `.relative` wrapper: #browse-panel (several levels up) clips overflow,
	// and `absolute`'s containing block is still inside that clip — only
	// `fixed` (viewport-relative) escapes it, given no ancestor here sets
	// transform/filter/perspective/contain to pull it back into a local one.
	function positionPresetListbox() {
		if (!presetTrigger || !presetListbox) return;
		const rect = presetTrigger.getBoundingClientRect();
		presetListbox.style.top = `${rect.bottom + 4}px`;
		presetListbox.style.left = `${rect.left}px`;
		presetListbox.style.width = `${rect.width}px`;
	}

	// A `fixed` popup doesn't track the page scrolling out from under it on
	// its own — the position computed above is a one-time snapshot, not a
	// live binding. Re-measure and re-anchor to the trigger on every
	// scroll/resize tick while open, rather than closing: closing on scroll
	// was tried first and reopened a race with the Browse Elements panel's
	// own open-time smooth-scroll (see the browseTrigger click handler) —
	// opening the listbox via keyboard while that unrelated scroll animation
	// was still mid-flight let its very next scroll tick close the listbox
	// the instant it opened. Repositioning has no such race (it's a no-op
	// if the trigger hasn't actually moved) and is also just better UX than
	// a dropdown that vanishes the moment the page scrolls at all. This also
	// fires for the listbox's own internal `overflow-y-auto` scrolling
	// (scroll events don't bubble, but capture-phase listeners on ancestors
	// still see them) — harmless, since re-reading the trigger's rect while
	// only the option list scrolled internally just recomputes the same
	// coordinates.
	function handlePresetViewportChange() {
		if (!presetOpen) return;
		positionPresetListbox();
	}

	function openPresetListbox() {
		if (presetOpen || !presetListbox || presetPicker.options.length === 0) return;
		presetOpen = true;
		positionPresetListbox();
		presetListbox.classList.remove('hidden');
		presetTrigger?.setAttribute('aria-expanded', 'true');
		const selected = presetPicker.getSelectedIndex();
		presetPicker.setActive(selected >= 0 ? selected : 0);
		document.addEventListener('click', handlePresetOutsideClick, true);
		window.addEventListener('scroll', handlePresetViewportChange, true);
		window.addEventListener('resize', handlePresetViewportChange);
	}

	function closePresetListbox() {
		if (!presetOpen) return;
		presetOpen = false;
		presetListbox?.classList.add('hidden');
		presetTrigger?.setAttribute('aria-expanded', 'false');
		presetPicker.clearActive();
		document.removeEventListener('click', handlePresetOutsideClick, true);
		window.removeEventListener('scroll', handlePresetViewportChange, true);
		window.removeEventListener('resize', handlePresetViewportChange);
	}

	function handlePresetOutsideClick(e: MouseEvent) {
		const target = e.target as Node;
		if (presetTrigger?.contains(target) || presetListbox?.contains(target)) return;
		closePresetListbox();
	}

	function presetTypeaheadSearch(char: string) {
		const from = presetOpen ? presetPicker.getActiveIndex() : presetPicker.getSelectedIndex();
		const idx = presetPicker.typeahead(char, from);
		if (idx < 0) return;
		if (!presetOpen) openPresetListbox();
		presetPicker.setActive(idx);
	}

	presetTrigger?.addEventListener('click', () => {
		if (presetOpen) closePresetListbox();
		else openPresetListbox();
	});

	presetTrigger?.addEventListener('keydown', (e) => {
		switch (e.key) {
			case 'ArrowDown':
				e.preventDefault();
				if (!presetOpen) openPresetListbox();
				else presetPicker.setActive(presetPicker.getActiveIndex() + 1);
				break;
			case 'ArrowUp':
				e.preventDefault();
				if (!presetOpen) openPresetListbox();
				else presetPicker.setActive(presetPicker.getActiveIndex() - 1);
				break;
			case 'Home':
				if (presetOpen) { e.preventDefault(); presetPicker.setActive(0); }
				break;
			case 'End':
				if (presetOpen) { e.preventDefault(); presetPicker.setActive(presetPicker.options.length - 1); }
				break;
			case 'Enter':
			case ' ':
				e.preventDefault();
				if (!presetOpen) { openPresetListbox(); break; }
				if (presetPicker.getActiveIndex() >= 0) presetPicker.commit(presetPicker.getActiveIndex());
				break;
			case 'Escape':
				if (presetOpen) { e.preventDefault(); closePresetListbox(); }
				break;
			case 'Tab':
				closePresetListbox();
				break;
			default:
				if (e.key.length === 1 && /\S/.test(e.key)) {
					presetTypeaheadSearch(e.key);
				}
		}
	});

	// Click and hover delegation live in createPresetListbox() — both instances
	// want them identically, so neither call site wires its own.

	// --- Element Grid (reusable) ---
	//
	// Stage 3 of the Molar Mass mode rebuild needs a second element grid — one
	// under the Molar Mass field, one on the old "Browse elements" tab — so this
	// was lifted out of the single hardcoded-#element-grid closure it used to be
	// and parameterised by its four DOM nodes. Everything inside is unchanged
	// from that version except the three bindings that had to become per-instance:
	// `quantities` (was a module-level Map shared with the formula bar), the grid
	// nodes, and the commit hop, which now calls the owner's onChange instead of
	// updateFormulaBar() directly. Each instance owns its own selection — the two
	// grids are independent pickers that happen to render the same catalogue, not
	// two views of one selection.
	type ElementGridInstance = {
		/** Re-render tiles, optionally filtered by name/symbol. Does not fire onChange. */
		render: (filter?: string) => void;
		/** Live selection map. Read-only to callers — write via setQuantities(). */
		quantities: Map<string, number>;
		/** Replace the selection and repaint. Does not fire onChange (the caller already knows). */
		setQuantities: (next: Map<string, number>) => void;
		/** Recompute whole-pixel columns. Also runs from the instance's ResizeObserver. */
		layout: () => void;
	};

	function createElementGrid(opts: {
		gridEl: HTMLElement | null;
		emptyEl: HTMLElement | null;
		scrollEl: HTMLElement | null;
		searchEl: HTMLInputElement | null;
		/** Fired after any user-driven selection change, with this instance's live map. */
		onChange: (quantities: Map<string, number>) => void;
		/**
		 * Column width the layout aims for, which is what decides the column
		 * COUNT at a given width (see layoutElementGrid). Per-instance because
		 * the two grids are not the same width: the accordion panel spans the
		 * calculator card's full content box, the Molar Mass panel is inset to
		 * the field card's content box and comes out 48px narrower, which is
		 * enough to drop it a whole column at the shared 244 target. Defaults to
		 * the accordion's documented value; see the Molar Mass panel's call site
		 * for why it asks for a narrower one.
		 */
		targetCol?: number;
	}): ElementGridInstance {
	const { gridEl: elementGrid, emptyEl: elementGridEmpty, scrollEl: elementGridScroll, searchEl: elementSearch, onChange } = opts;
	const quantities = new Map<string, number>();

	function renderGrid(filter = '') {
		if (!elementGrid) return;
		elementGrid.innerHTML = '';
		const lc = filter.toLowerCase().trim();
		const visible = lc
			? SEED_ELEMENTS.filter(el => el.name.toLowerCase().includes(lc) || el.symbol.toLowerCase().includes(lc))
			: SEED_ELEMENTS;

		const isEmpty = visible.length === 0;
		elementGrid.classList.toggle('hidden', isEmpty);
		elementGridEmpty?.classList.toggle('hidden', !isEmpty);

		visible.forEach(el => {
			const card = document.createElement('div');
			card.dataset.symbol = el.symbol;
			// min-h holds the tile above its natural height in BOTH states so
			// mounting the stepper never changes the row's height. This only
			// held true at `mobile:` (≥520px) and up, where the stepper button
			// is a 24px circle matching the chip — below 520px the stepper's
			// 44px touch-target wrapper (see stepButton below) is taller than
			// the 52px-floored unselected row, so selecting a tile grew it
			// 52px → 60px. Floor raised to 60px below 520px specifically —
			// matching the selected state's own height rather than the
			// unselected state's — so neither state has to grow into the
			// other. Desktop's 52px is unaffected; verified no height change
			// there (the 24px stepper never exceeds the 52px floor).
			card.className = 'flex min-h-[60px] mobile:min-h-[52px] items-center justify-between gap-2 rounded-md inset-ring-1 bg-surface p-2 transition-colors';

			// Tile body — clicking it is the select action
			const body = document.createElement('button');
			body.type = 'button';
			body.className = 'flex flex-1 min-w-0 items-center gap-3 text-left cursor-pointer select-none focus:outline-none';
			body.innerHTML = `
				<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xs bg-surface-4 font-sans text-base font-medium leading-none text-ink">${el.symbol}</span>
				<span class="flex min-w-0 flex-col gap-1">
					<span class="truncate font-sans text-sm leading-none text-ink">${el.name}</span>
					<span class="font-mono text-xs font-medium leading-none text-ink-subtle">${el.atomicWeight}</span>
				</span>
			`;

			// Stepper — mounted on select, removed on deselect. No container
			// border or fill: the controls sit directly on the tile, so the gap
			// carries the grouping that the box used to.
			const stepper = document.createElement('div');
			stepper.className = 'flex shrink-0 items-center gap-1';

			// 24px painted circle at every width; the button pads out to 44px on
			// touch so the hit area grows without the fill growing with it.
			function stepButton(kind: 'minus' | 'plus', glyph: string) {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.dataset.step = kind;
				btn.setAttribute('aria-label', `${kind === 'plus' ? 'Increase' : 'Decrease'} ${el.name} quantity`);
				// `mobile:` is the project's own 520px breakpoint (--breakpoint-mobile),
				// not Tailwind's stock md at 768 — the touch padding should drop at the
				// same width the rest of the layout switches to its desktop form.
				btn.className = 'group flex shrink-0 items-center justify-center p-2.5 mobile:p-0 cursor-pointer focus:outline-none';
				btn.innerHTML = `
					<span class="flex h-6 w-6 items-center justify-center rounded-[50%] text-ink-muted transition-colors group-hover:bg-surface-4">
						<span class="flex h-5 w-5 items-center justify-center">${glyph}</span>
					</span>
				`;
				return btn;
			}

			// Both glyphs share one square viewBox and one rendered box, so they
			// centre identically by construction — the minus IS the plus's
			// horizontal arm. The minus previously used a 1.5-unit-tall viewBox,
			// which clipped its own 1.75-unit stroke down to 1.28px and made it
			// visibly thinner than the plus.
			// 14 × 14 at viewBox 14 means scale is exactly 1, so a user unit is a
			// CSS pixel and the box centres on whole pixels in both containers:
			// (20 − 14) / 2 = 3 in the spacer span, (24 − 14) / 2 = 5 in the circle.
			// Painted extent is 0.25–13.75 (round caps overshoot each end by half
			// the stroke), which stays inside the 14px box — so no overflow-visible.
			const ICON_OPEN = '<svg width="14" height="14" viewBox="0 0 14 14" fill="none">';
			const ICON_ATTRS = 'stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';
			const minusBtn = stepButton('minus', `${ICON_OPEN}<path d="M1 7H13" ${ICON_ATTRS} /></svg>`);
			const plusBtn = stepButton('plus', `${ICON_OPEN}<path d="M7 1V13M1 7H13" ${ICON_ATTRS} /></svg>`);

			const qtyDisplay = document.createElement('span');
			qtyDisplay.className = 'text-center font-mono text-sm font-medium leading-none text-ink select-none';

			// Fixed width per digit count, not a floor with content sizing above it.
			// A content-sized count is fractional past nine (16.81px at 2 digits,
			// 25.20 at 3), which puts the plus button at a fractional x — the same
			// condition behind the original plus-glyph subpixel defect. Each width is
			// a multiple of 4 and clears the 8.4px monospace advance per digit.
			const COUNT_W = [12, 20, 28]; // 1, 2, 3 digits

			// The stepper only exists while selected, so its count is always a
			// live quantity — nothing here is a proposal, and nothing is inert.
			function sync() {
				const qty = quantities.get(el.symbol) ?? 0;
				const selected = qty > 0;
				card.classList.toggle('inset-ring-primary', selected);
				card.classList.toggle('inset-ring-hairline', !selected);
				// Hover feedback is unselected-only: the hover variant outranks
				// the green border, so leaving it on would grey out a selected tile.
				card.classList.toggle('hover:inset-ring-hairline-tertiary', !selected);
				// aria-current, not aria-pressed: body-click only ever selects,
				// so toggle-button semantics would misdescribe it. See DESIGN.md.
				if (selected) {
					body.setAttribute('aria-current', 'true');
					const text = String(qty);
					qtyDisplay.textContent = text;
					// Caps at the 3-digit width: past 999 the digits overflow the box
					// rather than widening it, which keeps the plus on a whole pixel.
					qtyDisplay.style.width = `${COUNT_W[Math.min(text.length, COUNT_W.length) - 1]}px`;
					if (!stepper.isConnected) card.appendChild(stepper);
				} else {
					body.removeAttribute('aria-current');
					stepper.remove();
				}
			}

			function commit() {
				sync();
				onChange(quantities);
			}

			// Body click is the select action: it reveals the stepper at 1
			body.addEventListener('click', () => {
				if ((quantities.get(el.symbol) ?? 0) > 0) return;
				quantities.set(el.symbol, 1);
				commit();
			});

			plusBtn.addEventListener('click', () => {
				quantities.set(el.symbol, (quantities.get(el.symbol) ?? 0) + 1);
				commit();
			});

			minusBtn.addEventListener('click', () => {
				const current = quantities.get(el.symbol) ?? 0;
				if (current <= 1) {
					quantities.delete(el.symbol);
				} else {
					quantities.set(el.symbol, current - 1);
				}
				commit();
			});

			stepper.appendChild(minusBtn);
			stepper.appendChild(qtyDisplay);
			stepper.appendChild(plusBtn);
			card.appendChild(body);
			// sync() mounts the stepper if this element is already selected —
			// it survives a search re-render, so don't append it unconditionally.
			sync();

			elementGrid.appendChild(card);
		});
	}

	// --- Element grid column math ---
	// `1fr` resolves to a fractional width (770 / 3 = 251.328125), and each
	// column inherits a different sub-pixel remainder (.3281 / .6563 / .9844),
	// so identical controls antialias differently from column to column. Solve
	// for whole-pixel columns and gaps instead, keeping the count responsive.
	const GRID_MIN_COL = 222;    // "Molybdenum" + mounted stepper — see DESIGN.md
	const GRID_TARGET_COL = opts.targetCol ?? 244; // design intent; 3 × 244 + 2 × 12 = 756 exactly
	const GRID_MIN_GAP = 8;
	// The wrapper is overflow-y:auto, so Chrome/Edge take a classic 15px
	// scrollbar out of its clientWidth and the grid drops a whole column.
	// Measure the wrapper's border box instead — that width is the same with
	// a classic scrollbar, an overlay scrollbar or none — and subtract a fixed
	// reserve. Below the mobile breakpoint scrollbars are overlay, so the
	// reserve buys nothing and only costs tile width. See DESIGN.md.
	const SCROLLBAR_RESERVE = 16;
	const RESERVE_MIN_VIEWPORT = 520;

	function layoutElementGrid() {
		if (!elementGrid || !elementGridScroll) return;
		const cs = getComputedStyle(elementGridScroll);
		const inner = elementGridScroll.getBoundingClientRect().width
			- parseFloat(cs.borderLeftWidth) - parseFloat(cs.borderRightWidth)
			- parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
		const reserve = window.matchMedia(`(min-width: ${RESERVE_MIN_VIEWPORT}px)`).matches
			? SCROLLBAR_RESERVE : 0;
		// Clamp to the real content box as a safety net: below the breakpoint there
		// is no reserve, and a *desktop* window narrowed under it still has a
		// classic scrollbar. Without the clamp the grid overflows by exactly the
		// scrollbar's width. At and above the breakpoint the clamp only binds if a
		// platform's scrollbar is wider than the reserve.
		const w = Math.min(Math.floor(inner) - reserve, elementGridScroll.clientWidth);
		if (w <= 0) return; // panel collapsed

		let n = Math.max(1, Math.floor((w + GRID_MIN_GAP) / (GRID_TARGET_COL + GRID_MIN_GAP)));
		// Never let a column fall under the width at which the longest name truncates
		while (n > 1 && Math.floor((w - (n - 1) * GRID_MIN_GAP) / n) < GRID_MIN_COL) n--;

		let colW = n === 1 ? w : Math.floor((w - (n - 1) * GRID_MIN_GAP) / n);
		let gap = GRID_MIN_GAP;
		if (n > 1) {
			// Largest pair where the column and the gap are both multiples of 4
			// and together fill the width exactly.
			let found = false;
			for (let c = colW - (colW % 4); c >= GRID_MIN_COL; c -= 4) {
				const rem = w - n * c;
				const g = rem / (n - 1);
				if (Number.isInteger(g) && g >= GRID_MIN_GAP && g % 4 === 0) {
					colW = c;
					gap = g;
					found = true;
					break;
				}
			}
			// No 4pt pair fits this width: fall back to integer-exact, walking the
			// column down until the leftover splits evenly across the gaps, so the
			// slack lands in the gaps and never in the columns.
			if (!found) {
				for (let c = colW; c > GRID_MIN_COL; c--) {
					const rem = w - n * c;
					if (rem % (n - 1) === 0 && rem / (n - 1) >= GRID_MIN_GAP) {
						colW = c;
						gap = rem / (n - 1);
						break;
					}
				}
			}
		}
		// Pin the width so the result is the computed value, not whatever the
		// parent happens to offer once the scrollbar appears.
		elementGrid.style.width = `${w}px`;
		elementGrid.style.gridTemplateColumns = `repeat(${n}, ${colW}px)`;
		elementGrid.style.columnGap = `${gap}px`;
	}

	if (elementGridScroll) new ResizeObserver(layoutElementGrid).observe(elementGridScroll);

	// --- Search ---
	elementSearch?.addEventListener('input', () => {
		renderGrid(elementSearch.value);
	});

	// Initial render
	renderGrid();

	return {
		render: renderGrid,
		quantities,
		setQuantities(next) {
			quantities.clear();
			next.forEach((v, k) => quantities.set(k, v));
			// Keep whatever the user has typed in this instance's search box —
			// restoring a selection is not a reason to widen their filter back out.
			renderGrid(elementSearch?.value ?? '');
		},
		layout: layoutElementGrid,
	};
	}

	// --- Browse-elements accordion: Build custom tab ---
	// The original grid instance, unchanged in behaviour: its selection still
	// only reaches Molar Mass through the #use-custom button below. Stage 5
	// removes this whole accordion; until then it and the mode panel's grid are
	// two independent pickers.
	const customGrid = createElementGrid({
		gridEl: elementGrid,
		emptyEl: elementGridEmpty,
		scrollEl: elementGridScroll,
		searchEl: elementSearch,
		onChange: updateFormulaBar,
	});

	// --- Formula bar ---
	function updateFormulaBar(quantities: Map<string, number>) {
		const hasSelection = quantities.size > 0;
		const formula = hasSelection ? buildFormula(quantities) : '—';
		const mass = hasSelection ? computeCustomMolarMass(quantities) : 0;

		if (customFormula) customFormula.textContent = formula || '—';
		if (customMolarMassVal) {
			customMolarMassVal.textContent = hasSelection ? `${mass.toFixed(3)} g/mol` : '—';
		}
		useCustomBtn?.classList.toggle('hidden', !hasSelection);
	}

	useCustomBtn?.addEventListener('click', () => {
		if (!molarMassInput) return;
		const mass = computeCustomMolarMass(customGrid.quantities);
		molarMassInput.value = String(mass.toFixed(3));
		molarMassInput.dispatchEvent(new Event('input'));
		collapsePanel();
		customGrid.setQuantities(new Map());
		if (elementSearch) elementSearch.value = '';
		updateFormulaBar(customGrid.quantities);
	});

	// --- Molar Mass "Build custom" panel (stage 3) ---
	//
	// The second instance of the same grid, mounted under the Molar Mass field
	// (see the markup comment on #molar-mass-build-panel). Unlike the accordion
	// tab there is no confirm step: every tile click writes the build-custom
	// mode slot immediately, and stage 2's setModeValue() pushes that straight
	// into #molar-mass, so the field tracks the selection live.
	//
	// `quantities` is what gets stored, not just the derived formula/mass — it
	// is what restores the grid's per-tile counts when the user comes back to
	// this mode. Stored as a Record (Object.fromEntries), per the slot's shape
	// note in the stage-2 section: a Map wouldn't survive the structured clone
	// Playwright reads the store through.
	buildCustomGrid = createElementGrid({
		gridEl: document.getElementById('molar-mass-element-grid'),
		emptyEl: document.getElementById('molar-mass-element-grid-empty'),
		scrollEl: document.getElementById('molar-mass-element-grid-scroll'),
		searchEl: document.getElementById('molar-mass-element-search') as HTMLInputElement | null,
		// This panel is inset to the field card's content box, so its grid gets
		// 712px where the accordion's gets 760px — under the 748px the shared 244
		// target needs for a third column, which would render this panel 2-up
		// against a design that is 3-up. 232 is the largest 4pt-aligned target
		// that keeps three columns here (3 × 232 + 2 × 8 = 712 exactly, and 232
		// clears the 222px truncation floor with room to spare). Scoped to this
		// instance rather than lowered globally: the accordion is 3-up at every
		// desktop width either way, but the two targets disagree in a ~40px band
		// of viewport widths around 880px, and there is no reason to move that
		// boundary on a panel this change isn't about.
		targetCol: 232,
		onChange: (quantities) => {
			// Guards the round trip: setModeValue() below calls back into
			// onBuildCustomStateChanged(), which would otherwise rebuild all ~110
			// tiles on every +/- click to restore a selection this grid is already
			// showing. External writes (stage 4's siblings, the test hook) leave
			// the flag false and do get the repaint.
			buildCustomPanelWriting = true;
			setModeValue('build-custom', quantities.size === 0
				? { quantities: null, formula: null, molarMass: null }
				: {
					quantities: Object.fromEntries(quantities),
					formula: buildFormula(quantities),
					// Rounded at the write site, matching #use-custom's toFixed(3) —
					// the slot stores a display-precision number, not a raw float.
					molarMass: Number(computeCustomMolarMass(quantities).toFixed(3)),
				});
			buildCustomPanelWriting = false;
		},
	});
	// --- Molar Mass "Compounds" panel (stage 4) ---
	//
	// The second instance of the compound picker, mounted under the Molar Mass
	// field (see #molar-mass-compounds-panel). No trigger and no open/close: the
	// mode dropdown already chose this mode, so the list is simply present while
	// it is active, and the panel element itself is the focusable listbox that
	// carries aria-activedescendant.
	//
	// Selecting writes the compounds slot and stops there — stage 2's
	// setModeValue() puts the mass in #molar-mass and announces the recalc. The
	// panel deliberately does NOT close on selection: it is the mode's UI, not a
	// popup, and there would be no way back to it without changing mode twice.
	compoundsPicker = createPresetListbox({
		listboxEl: molarMassCompoundsPanel,
		idPrefix: 'molar-mass-compound',
		activeDescendantHost: molarMassCompoundsPanel,
		onSelect: (preset) => {
			// Same round-trip guard as the Build-custom panel: setModeValue()
			// calls back into onCompoundsStateChanged(), which has nothing to do
			// for a selection this instance just painted itself.
			compoundsPanelWriting = true;
			setModeValue('compounds', {
				name: preset.name,
				formula: preset.formula,
				molarMass: preset.molarMass,
			});
			compoundsPanelWriting = false;
		},
	});

	// Keyboard support for an always-open listbox: the index math is the same as
	// the accordion trigger's, minus everything about opening and closing
	// (ArrowUp/Down never have to open it, and Escape/Tab have nothing to
	// collapse). Typeahead searches from the current highlight rather than the
	// accordion's open-dependent origin, since here the list is always open.
	molarMassCompoundsPanel?.addEventListener('keydown', (e) => {
		if (!compoundsPicker) return;
		const active = compoundsPicker.getActiveIndex();
		switch (e.key) {
			case 'ArrowDown':
				e.preventDefault();
				compoundsPicker.setActive(active + 1);
				break;
			case 'ArrowUp':
				e.preventDefault();
				compoundsPicker.setActive(active - 1);
				break;
			case 'Home':
				e.preventDefault();
				compoundsPicker.setActive(0);
				break;
			case 'End':
				e.preventDefault();
				compoundsPicker.setActive(compoundsPicker.options.length - 1);
				break;
			case 'Enter':
			case ' ':
				e.preventDefault();
				if (active >= 0) compoundsPicker.commit(active);
				break;
			default:
				if (e.key.length === 1 && /\S/.test(e.key)) {
					const idx = compoundsPicker.typeahead(e.key, active);
					if (idx >= 0) compoundsPicker.setActive(idx);
				}
		}
	});

	// Paint each panel from whatever its slot already holds, then show whichever
	// one the active mode calls for.
	onBuildCustomStateChanged();
	onCompoundsStateChanged();
	syncMolarMassModePanels();
</script>
