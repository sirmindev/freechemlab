									type="button"
									id="preset-trigger"
									role="combobox"
									aria-haspopup="listbox"
									aria-expanded="false"
									aria-controls="preset-listbox"
									aria-labelledby="preset-label preset-trigger-label"
									class="w-full flex items-center justify-between gap-2 bg-surface-soft inset-ring-1 inset-ring-hairline text-ink text-sm font-sans text-left rounded-[8px] pl-3 pr-8 py-[12px] mobile:py-[10px] cursor-pointer focus:outline-none focus:inset-ring-2 focus:inset-ring-primary transition-all"
								>
