								<input
									type="number"
									id="moles-input"
									step="1"
									readonly
									placeholder="0.000000"
									class="w-full bg-transparent text-ink-tertiary font-mono text-[32px] font-medium rounded-none border-0 px-0 py-0 cursor-not-allowed select-none focus:outline-none transition-all"
									style="line-height: 1.2;"
								/>
								<!-- Functional stepper — shown only while this field is editable (mol -> g mode).
								     See molar-mass-stepper above for the capsule-shape/fill/hit-area
								     rationale — identical component, reused verbatim. -->
								<div id="moles-input-stepper" class="hidden absolute right-2 top-1/2 -translate-y-1/2 flex items-center">
									<button type="button" id="moles-step-down" aria-label="Decrease moles" class="hidden group flex items-center justify-center py-2 mobile:py-2.5 cursor-not-allowed focus:outline-none">
										<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-l-full bg-surface-4 text-ink-tertiary transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
											<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</span>
									</button>
									<div id="moles-stepper-divider" class="hidden w-px h-8 mobile:h-6 bg-white"></div>
									<button type="button" id="moles-step-up" aria-label="Increase moles" class="group flex items-center justify-center py-2 mobile:py-2.5 cursor-pointer focus:outline-none">
										<span class="flex h-8 w-8 mobile:h-6 mobile:w-6 items-center justify-center rounded-full bg-surface-4 text-ink-muted transition-colors group-hover:bg-hairline-tertiary [@media(hover:hover)]:group-active:bg-ink-tertiary">
											<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</span>
									</button>
								</div>
								<!-- Copy Result Button (Shown when readonly) -->
								<button
									type="button"
									id="moles-copy-btn"
									aria-label="Copy moles result"
									disabled
									class="absolute right-0 flex min-h-[44px] min-w-[44px] items-center justify-center text-ink-tertiary cursor-not-allowed transition-colors"
								>
									<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
									</svg>
